#!/usr/bin/env bash
# Stop before replacing binaries, preserving all state.
set -Eeuo pipefail
fct_on_error() { printf '%s\n' 'LimeOS services could not be stopped; package removal has stopped.' >&2; }
trap fct_on_error ERR
fct_main() {
    case "${1:-}" in
        remove|deconfigure|upgrade)
            if [[ -d /run/systemd/system ]]; then systemctl stop limeos-core.service limeos-containerd.service limeos-storaged.service; fi
            if [[ -d /run/systemd/system ]]; then
                local unit
                for unit in limeos-storage-reader.service limeos-storage-ready.service limeos-storage-targets.service; do
                    # Earlier packages do not contain these optional services.
                    if [[ "$(systemctl show "${unit}" -p LoadState --value)" == loaded ]]; then systemctl stop "${unit}"; fi
                done
            fi
            ;;
    esac
}
fct_main "$@"
