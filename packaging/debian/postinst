#!/usr/bin/env bash
# Validate preserved configuration before activating dedicated service accounts.
set -Eeuo pipefail
fct_on_error() { printf '%s\n' 'LimeOS configuration failed; correct the named problem, then run dpkg --configure limeos.' >&2; }
trap fct_on_error ERR
fct_account() {
    local account="${1}" uid account_shell
    if getent passwd "${account}" >/dev/null; then
        uid="$(id -u "${account}")"
        if (( uid < 100 || uid >= 1000 )); then printf 'Refusing non-system account: %s\n' "${account}" >&2; return 1; fi
        account_shell="$(getent passwd "${account}" | cut -d: -f7)"
        if [[ "${account_shell}" != /usr/sbin/nologin ]]; then printf 'Refusing login-enabled service account: %s\n' "${account}" >&2; return 1; fi
        if [[ "${account}" != limeos-containerd && " $(id -nG "${account}") " == *' docker '* ]]; then
            printf 'Refusing Docker access for service account: %s\n' "${account}" >&2; return 1
        fi
    else
        adduser --system --group --no-create-home --home /nonexistent --shell /usr/sbin/nologin "${account}"
    fi
}
fct_directory() {
    local directory="${1}" owner="${2}" mode="${3}"
    if [[ -L "${directory}" ]]; then printf 'Refusing symlink: %s\n' "${directory}" >&2; return 1; fi
    install -d -o "${owner}" -g "${owner}" -m "${mode}" "${directory}"
}
# A ceiling loaded by an unprivileged role: root-owned, readable through the
# group the role's unit runs with (its primary group, so no membership in
# /etc/group is needed) and writable only by root. Applied on every configure,
# because an older package created host.json root:root and an operator may
# have left it 0600 or 0640, which limeos-storaged cannot read.
fct_reader_access() {
    local file="${1}" group="${2}"
    if [[ -L "${file}" || ! -f "${file}" ]]; then printf 'Refusing non-regular ceiling: %s\n' "${file}" >&2; return 1; fi
    chown root:"${group}" "${file}"
    chmod 0640 "${file}"
}
# The units prerm recorded as running when it stopped them, in stop order.
# Only these may be started from the record; effect units never are.
RESTARTED_UNITS=(limeos-core.service limeos-containerd.service limeos-storaged.service limeos-storage-reader.service)
RESTART_DIRECTORY=/run/limeos-package
RECORDED=()
fct_systemd_running() { [[ -d "${DPKG_ROOT:-}/run/systemd/system" ]]; }
# Owned by the user running this script (root under dpkg), no symlink, and
# writable by no one else.
fct_safe_path() {
    local path="${1}" kind="${2}" owner mode type
    if [[ -L "${path}" ]]; then return 1; fi
    read -r owner mode type < <(stat -c '%u %a %F' -- "${path}") || return 1
    [[ "${owner}" == "${EUID}" && "${type}" == "${kind}" ]] || return 1
    (( (8#${mode} & 8#022) == 0 ))
}
# Read and delete the record: configure and the abort actions end the
# transaction prerm began, whether or not anything is then started. An
# unsafe record is ignored; a directory that is not ours is left alone.
fct_take_record() {
    local directory="${DPKG_ROOT:-}${RESTART_DIRECTORY}" line allowed known
    RECORDED=()
    [[ -e "${directory}" || -L "${directory}" ]] || return 0
    if ! fct_safe_path "${directory}" directory; then
        printf 'Warning: ignoring unsafe restart record directory %s\n' "${directory}" >&2
        return 0
    fi
    if [[ -e "${directory}/units" || -L "${directory}/units" ]]; then
        if fct_safe_path "${directory}/units" 'regular file' || fct_safe_path "${directory}/units" 'regular empty file'; then
            while IFS= read -r line || [[ -n "${line}" ]]; do
                [[ -n "${line}" ]] || continue
                known=0
                for allowed in "${RESTARTED_UNITS[@]}"; do [[ "${allowed}" != "${line}" ]] || known=1; done
                if (( known )); then
                    RECORDED+=("${line}")
                else
                    printf 'Warning: ignoring unexpected restart record entry: %s\n' "${line}" >&2
                fi
            done <"${directory}/units"
        else
            printf 'Warning: ignoring unsafe restart record %s\n' "${directory}/units" >&2
        fi
    fi
    rm -rf -- "${directory}"
}
# Start the recorded units in reverse stop order, skipping the named units
# (configure restarts the core units itself). A unit the administrator has
# since masked or disabled is skipped with a warning. A unit that does not
# start is named and the others still start.
fct_restore_units() {
    local unit skipped index failed=0 load_state file_state
    fct_take_record
    for (( index=${#RECORDED[@]}-1; index>=0; index-- )); do
        unit="${RECORDED[index]}"
        for skipped in "$@"; do [[ "${skipped}" != "${unit}" ]] || continue 2; done
        if ! load_state="$(systemctl show "${unit}" -p LoadState --value)" || ! file_state="$(systemctl show "${unit}" -p UnitFileState --value)"; then
            printf 'Could not query %s, which was running before the package change; start it with: systemctl start %s\n' "${unit}" "${unit}" >&2
            failed=1
            continue
        fi
        if [[ "${load_state}" == masked || "${file_state}" == masked* ]]; then
            printf 'Warning: not starting %s: it was masked after it was stopped.\n' "${unit}" >&2
            continue
        fi
        if [[ "${file_state}" == disabled ]]; then
            printf 'Warning: not starting %s: it was disabled after it was stopped.\n' "${unit}" >&2
            continue
        fi
        if ! systemctl start "${unit}"; then
            printf 'Could not start %s, which was running before the package change; start it with: systemctl start %s\n' "${unit}" "${unit}" >&2
            failed=1
        fi
    done
    (( failed == 0 ))
}
fct_execute_this() {
    /usr/lib/limeos/limeosctl check-config /etc/limeos/core.json
    local account group core_uid
    for account in limeos-core limeos-containerd limeos-storaged limeos-assistant; do fct_account "${account}"; done
    for group in limeos-rpc limeos-host-access limeos-container-access docker; do
        getent group "${group}" >/dev/null || addgroup --system "${group}"
    done
    if [[ -L /var/lib/limeos || -L /etc/limeos/system-policy ]]; then printf '%s\n' 'Refusing symlink in managed state paths.' >&2; return 1; fi
    fct_directory /var/lib/limeos root 0755
    fct_directory /etc/limeos root 0755
    fct_directory /var/lib/limeos/core limeos-core 0700
    fct_directory /var/lib/limeos/assistant limeos-assistant 0700
    fct_directory /var/lib/limeos/executors root 0755
    fct_directory /var/lib/limeos/executors/storage root 0700
    fct_directory /var/lib/limeos/executors/container limeos-containerd 0700
    fct_directory /etc/limeos/system-policy root 0755
    core_uid="$(id -u limeos-core)"
    local target temporary
    for target in host container storage; do
        if [[ -e "/etc/limeos/system-policy/${target}.json" || -L "/etc/limeos/system-policy/${target}.json" ]]; then
            /usr/lib/limeos/limeosctl check-ceiling "/etc/limeos/system-policy/${target}.json" "${core_uid}"
            continue
        fi
        temporary="$(mktemp "/etc/limeos/system-policy/.${target}.XXXXXX")"
        if [[ "${target}" == host ]]; then
            printf '{"version":1,"core_uid":%s,"allow_health":true,"allow_host_read":true,"allow_container_read":false,"allow_restart":false,"managed_containers":[]}\n' "${core_uid}" >"${temporary}"
        elif [[ "${target}" == container ]]; then
            printf '{"version":1,"core_uid":%s,"allow_health":true,"allow_host_read":false,"allow_container_read":true,"allow_restart":false,"managed_containers":[]}\n' "${core_uid}" >"${temporary}"
        else
            printf '{"version":1,"core_uid":%s,"allow_health":true,"allow_storage_read":true,"allow_stack_read":true,"allow_container_health_read":true,"managed_containers":[]}\n' "${core_uid}" >"${temporary}"
        fi
        chown root:root "${temporary}"
        chmod 0644 "${temporary}"
        sync -f "${temporary}"
        mv -fT "${temporary}" "/etc/limeos/system-policy/${target}.json"
        sync -f /etc/limeos/system-policy
    done
    # limeos-storaged reads host.json (its directories are 0755 above); its
    # runtime directory and socket are created at each start by systemd and
    # the role, owned by it with group limeos-host-access, which core holds as
    # a supplementary group; it has no state directory. container.json and
    # storage.json keep their owners: their readers never changed.
    fct_reader_access /etc/limeos/system-policy/host.json limeos-host-access
    if fct_systemd_running; then
        systemctl daemon-reload
        systemctl enable limeos-core.service limeos-containerd.service limeos-storaged.service
        systemctl restart limeos-storaged.service limeos-containerd.service limeos-core.service
        # Optional units that were running before an upgrade start again.
        local attempt restored=0
        fct_restore_units limeos-core.service limeos-containerd.service limeos-storaged.service || restored=1
        for (( attempt=0; attempt<75; attempt++ )); do
            if systemctl is-active --quiet limeos-core.service limeos-containerd.service limeos-storaged.service && /usr/lib/limeos/limeosctl --socket /run/limeos-core/core.sock status >/dev/null 2>&1; then
                (( restored == 0 )) || return 1
                return 0
            fi
            sleep 0.2
        done
        printf '%s\n' 'LimeOS did not become ready within 15 seconds; inspect journalctl -u limeos-core.' >&2
        return 1
    fi
    # Without a manager nothing is restarted, but the transaction still ends.
    fct_take_record
}
# prerm stopped the services and nothing was replaced: start what it stopped.
fct_abort() {
    if ! fct_systemd_running; then fct_take_record; return 0; fi
    systemctl daemon-reload
    fct_restore_units
}
fct_main() {
    case "${1:-}" in
        configure) fct_execute_this ;;
        abort-upgrade|abort-remove|abort-deconfigure) fct_abort ;;
        *)
            trap - ERR
            printf 'postinst called with unknown argument: %s\n' "${1:-}" >&2
            return 1
            ;;
    esac
}
fct_main "$@"
