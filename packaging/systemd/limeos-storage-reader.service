[Unit]
Description=LimeOS fresh storage inventory (read only)
After=local-fs.target

[Service]
# Type=exec arms the watchdog at exec, which is enough here: before its first
# keep-alive (sent as soon as the accept loop runs) the role only reads a
# policy of at most 64 KiB and the installed stack selection and binds its
# socket, well under a second; device reads start later, off that thread.
Type=exec
# Its own account, as the container executor has. Core trusts this socket by
# the container executor's rule: owned by an account that is neither root nor
# core, which the kernel names as the peer (limeos_contracts::ExecutorOwner).
# What the reads need beyond that account, and nothing else:
# - CAP_DAC_READ_SEARCH, for the inventory's read-only opens of block device
#   nodes (root:disk 0660) and blkid's reopen of them through
#   /proc/PID/fd/N, which is why it is ambient (blkid inherits it); the
#   fixed readers refuse to run without root or this capability
#   (full_read_access, in executor-storage and executor-container). It also
#   lets the reader read every file, as root's owner read of the raw disks
#   already did; it grants no write. The disk group was the alternative: it
#   grants raw write to every disk. A udev rule giving this account read-only
#   ACLs on block nodes would be narrower still and is not qualified.
# - docker, for the stack and container-health reads, which are GET requests
#   on /run/docker.sock (root:docker 0660). The Docker API is root-equivalent
#   for whoever can reach it, so a compromised reader can still become root
#   through dockerd, as it was root before; what this account removes is the
#   reader's owner write on every root-owned file (/etc, /usr/lib/limeos,
#   /proc/sys, /sys) and on the disks.
# Everything else it reads is world-readable: sysfs, /proc/self/mountinfo,
# /proc/1/mountinfo, /proc/swaps, /etc/fstab, the ceiling (root-owned, group
# limeos-host-access, 0640) and the management catalog (root-owned, 0644).
User=limeos-storage-reader
Group=limeos-host-access
SupplementaryGroups=docker
ExecStart=/usr/lib/limeos/limeos-executor /etc/limeos/system-policy/storage.json /run/limeos-storage-reader/executor.sock storage
RuntimeDirectory=limeos-storage-reader
RuntimeDirectoryMode=0750
UMask=0077
LimitCORE=0
MemorySwapMax=0
Restart=on-failure
RestartSec=2s
# Keep-alives are sent from the accept loop, so systemd restarts the unit
# only if that loop stops being run. Longest legitimate stretch on that
# loop's thread: framing and cached answers, well under a millisecond. The
# device reads run elsewhere: inventory (sysfs, block devices, blkid) on its
# own thread under a 4 s deadline, container health and the stack refresh
# on the blocking pool. Far under 10 s, a third of the interval. A storage
# read stuck past its deadline
# does not stop them: a restart would not free it (the thread stays in this
# cgroup) and would abort healthy reads; the reader refuses inventories and
# reports it to core, which lists the reader as degraded.
WatchdogSec=30s
TimeoutStartSec=15s
TimeoutStopSec=5s
NoNewPrivileges=yes
# A mount namespace sandbox would hide or clone the host mount identity.
# The reader has no effectful request, shell or write flag.
PrivateMounts=no
PrivateDevices=no
# What this leaves: the reader compares its root mount ID with PID 1's, and a
# cloned namespace allocates new IDs, so every setting systemd implements with
# a mount namespace is off: ProtectSystem, ProtectHome, PrivateTmp,
# PrivateDevices, ProtectKernelTunables/Modules/Logs, ProtectControlGroups,
# ProtectProc, ProcSubset, and PrivateNetwork (it mounts a fresh /sys).
# ProtectHome and PrivateTmp therefore stay off even as a dedicated account.
# What limits the account's writes is file ownership: it owns its runtime
# directory and socket and nothing else. ProtectClock is off because its
# implied DeviceAllow rule would close the device policy and refuse the
# block-device reads; DevicePolicy=closed with DeviceAllow=block-* r was
# considered (it would also make the device reads read-only in the kernel)
# and needs Pi qualification first: systemd resolves block-* from
# /proc/devices at start, so a disk whose driver loads later is refused.
# Also off, as unqualified: ProtectHostname (whether it needs a mount namespace
# varies with the systemd version) and PrivateUsers (it would map core's UID
# to the overflow UID in SO_PEERCRED, and PID 1's /proc entries are qualified
# only in the host user namespace).
# This filter rejects openat2's indirect arguments, including protected reads.
# The fixed read role needs openat2; it has no file-write operation.
RestrictSUIDSGID=no
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=CAP_DAC_READ_SEARCH
AmbientCapabilities=CAP_DAC_READ_SEARCH
# Possible now that the account is not root: its SysV IPC objects go with it.
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service openat2
# @resources stays: the read guardian lowers its own file-descriptor limit.
SystemCallFilter=~@privileged
LimitNOFILE=256
TasksMax=16
MemoryMax=64M
CPUQuota=50%
# Deliberately no Install section or package enable/start action.
