[Unit]
Description=LimeOS approved nonpersistent storage mount
After=local-fs.target
ConditionPathExists=/etc/limeos/system-policy/storage-mounts.json
ConditionPathExists=/etc/limeos/storage-contract.json
ConditionPathExists=/etc/limeos/pools.json
ConditionPathExists=/etc/limeos/protection.json
ConditionPathExists=/etc/limeos/shares.json

[Service]
Type=exec
User=root
Group=limeos-host-access
ExecStart=/usr/lib/limeos/limeos-executor /etc/limeos/system-policy/storage-mounts.json /run/limeos-storage-mounts/executor.sock storage-mounts
RuntimeDirectory=limeos-storage-mounts
RuntimeDirectoryMode=0750
UMask=0077
LimitCORE=0
MemorySwapMax=0
Restart=no
# No watchdog: an interrupted mount needs an operator (hence Restart=no), and
# one mount operation, run on the loop's thread, may legitimately hold it
# longer than any keep-alive interval on a slow device.
TimeoutStartSec=15s
TimeoutStopSec=5s
KillMode=control-group
SendSIGKILL=yes
NoNewPrivileges=yes
# Host-visible mounts require the actual PID 1 root/mount namespace. These
# settings apply only to this opt-in effect role; readers retain their profiles.
# Filesystem namespace sandboxes, path bind rules and hidden proc are excluded.
PrivateMounts=no
PrivateTmp=no
PrivateDevices=no
PrivateUsers=no
ProtectSystem=no
ProtectHome=no
ProtectKernelTunables=no
ProtectKernelModules=no
ProtectControlGroups=no
ProtectProc=default
ProcSubset=all
# RestrictSUIDSGID blocks openat2 in the qualified reader findings. Root code
# and the dedicated capability/syscall bounds are checked independently.
RestrictSUIDSGID=no
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictNamespaces=yes
IPAddressDeny=any
RestrictAddressFamilies=AF_UNIX
# Known gap: only the guardian's fixed helper needs CAP_SYS_ADMIN (mount), and
# only admission needs CAP_SYS_PTRACE and CAP_DAC_READ_SEARCH (other
# processes' /proc entries, root-only reads). For a root service the bounding
# set alone decides what every exec'd process holds, so the long-lived
# socket-facing process, the guardian, mount(8) and every other child hold
# all three; AmbientCapabilities adds nothing for root and is listed to make
# that explicit. Holding CAP_SYS_ADMIN only in the helper needs the helper in
# its own privileged unit, or capability dropping in code, which is a rewrite
# of the guardian protocol; until then the opt-in, Restart=no profile and the
# syscall filter below are the bound.
CapabilityBoundingSet=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_ADMIN
AmbientCapabilities=CAP_DAC_READ_SEARCH CAP_SYS_PTRACE CAP_SYS_ADMIN
SystemCallArchitectures=native
# Existing readers need openat2; the fixed helper alone needs mount. Guardian
# supervision uses pidfds, a subreaper, session creation and sealed exec images.
SystemCallFilter=@system-service openat2 mount pidfd_open pidfd_send_signal prctl setsid memfd_create
LimitNOFILE=256
TasksMax=16
MemoryMax=64M
CPUQuota=50%
# No Install section, socket activation, package start, or default write ceiling.
# Disposable-guest qualification and explicit root provisioning are required.
