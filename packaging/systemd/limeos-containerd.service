[Unit]
Description=LimeOS containerd
After=network.target

[Service]
Type=exec
User=limeos-containerd
Group=limeos-container-access
SupplementaryGroups=docker
ExecStart=/usr/lib/limeos/limeos-executor /etc/limeos/system-policy/container.json /run/limeos-containerd/executor.sock container /var/lib/limeos/executors/container
StateDirectory=limeos/executors/container
StateDirectoryMode=0700
RuntimeDirectory=limeos-containerd
RuntimeDirectoryMode=0750
UMask=0077
LimitCORE=0
MemorySwapMax=0
ProtectProc=invisible
Restart=on-failure
RestartSec=2s
# No watchdog. Engine calls are async with deadlines, but the receipt
# store's SQLite commits (synchronous=FULL) and directory fsyncs run on the
# single runtime thread that would send keep-alives. Each is an fsync to the
# SD card: milliseconds normally, with no upper bound while the card is busy
# writing back (an image pull, say), so not provably under 10 s, a third of
# a 30 s watchdog. A watchdog would abort a healthy execute mid-fsync and
# leave receipts to reconcile, and a restart cannot speed up the device. A
# stuck loop shows in core instead: calls fail at their deadline and jobs
# are held for reconciliation.
TimeoutStartSec=15s
TimeoutStopSec=15s
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes

ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallArchitectures=native
SystemCallFilter=@system-service
LimitNOFILE=128
TasksMax=16
MemoryMax=32M
CPUQuota=50%
[Install]
WantedBy=multi-user.target
