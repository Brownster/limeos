#!/usr/bin/env python3
"""Rehearsal stand-in for genisoimage: concatenates the inputs under a cidata marker."""
import sys
from pathlib import Path

args = sys.argv[1:]
output = Path(args[args.index("-output") + 1])
files = [a for a in args if not a.startswith("-") and Path(a).is_file() and a != str(output)]
if "-volid" not in args or args[args.index("-volid") + 1] != "cidata" or not files:
    sys.exit("genisoimage: a cidata volume with user-data and meta-data is required")
output.write_bytes(b"CD001cidata\n" + b"".join(Path(f).read_bytes() for f in files))
