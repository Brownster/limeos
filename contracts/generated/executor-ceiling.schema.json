{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Ceiling",
  "type": "object",
  "properties": {
    "allow_container_logs": {
      "type": "boolean",
      "default": false
    },
    "allow_container_read": {
      "type": "boolean",
      "default": false
    },
    "allow_health": {
      "type": "boolean"
    },
    "allow_host_read": {
      "type": "boolean",
      "default": false
    },
    "allow_restart": {
      "type": "boolean",
      "default": false
    },
    "allow_start": {
      "type": "boolean",
      "default": false
    },
    "allow_stop": {
      "type": "boolean",
      "default": false
    },
    "allow_storage_read": {
      "type": "boolean",
      "default": false
    },
    "core_uid": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "managed_containers": {
      "type": "array",
      "default": [],
      "items": {
        "type": "string"
      }
    },
    "version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "core_uid",
    "allow_health"
  ]
}
