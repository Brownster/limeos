{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SnapraidSyncPreview",
  "type": "object",
  "properties": {
    "configuration": {
      "$ref": "#/$defs/SnapraidPreview"
    },
    "diff": {
      "$ref": "#/$defs/SnapraidDiffEvidence"
    },
    "expected_sources": {
      "$ref": "#/$defs/ProtectionSourceEvidence"
    }
  },
  "additionalProperties": false,
  "required": [
    "configuration",
    "expected_sources",
    "diff"
  ],
  "$defs": {
    "ProtectionPathKind": {
      "type": "string",
      "enum": [
        "source",
        "data",
        "content",
        "parity"
      ]
    },
    "ProtectionPathObservation": {
      "description": "Adapter attestation from retained, no-symlink descriptors in the host namespace.",
      "type": "object",
      "properties": {
        "device": {
          "$ref": "#/$defs/StorageBlockDevice"
        },
        "mount_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ProtectionPathState"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "state",
        "device",
        "mount_id"
      ]
    },
    "ProtectionPathRequirement": {
      "type": "object",
      "properties": {
        "expected": {
          "$ref": "#/$defs/StorageDevice"
        },
        "kind": {
          "$ref": "#/$defs/ProtectionPathKind"
        },
        "path": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "kind",
        "expected"
      ]
    },
    "ProtectionPathState": {
      "type": "string",
      "enum": [
        "directory",
        "regular_file",
        "absent_file",
        "unavailable",
        "unsafe"
      ]
    },
    "ProtectionSourceEvidence": {
      "type": "object",
      "properties": {
        "inventory": {
          "$ref": "#/$defs/StorageInventory"
        },
        "observed_at": {
          "type": "integer",
          "format": "int64"
        },
        "paths": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtectionPathObservation"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "observed_at",
        "inventory",
        "paths"
      ]
    },
    "SnapraidConfig": {
      "type": "object",
      "properties": {
        "drives": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/SnapraidDrive"
          }
        },
        "enabled": {
          "type": "boolean"
        },
        "excludes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "schedule": {
          "$ref": "#/$defs/SnapraidSchedule"
        },
        "scrub": {
          "$ref": "#/$defs/SnapraidScrub"
        },
        "settings": {
          "$ref": "#/$defs/SnapraidSettings"
        },
        "thresholds": {
          "$ref": "#/$defs/SnapraidThresholds"
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "drives",
        "excludes",
        "settings",
        "thresholds",
        "scrub",
        "schedule"
      ]
    },
    "SnapraidDiff": {
      "type": "object",
      "properties": {
        "added": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "copied": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "moved": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "removed": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "restored": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "updated": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "added",
        "removed",
        "updated",
        "moved",
        "copied",
        "restored"
      ]
    },
    "SnapraidDiffEvidence": {
      "type": "object",
      "properties": {
        "configuration": {
          "$ref": "#/$defs/SnapraidConfig"
        },
        "mounts_digest": {
          "type": "string"
        },
        "observed_at": {
          "type": "integer",
          "format": "int64"
        },
        "outcome": {
          "$ref": "#/$defs/SnapraidDiffOutcome"
        },
        "topology_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "observed_at",
        "configuration",
        "topology_digest",
        "mounts_digest",
        "outcome"
      ]
    },
    "SnapraidDiffOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "parsed"
            },
            "value": {
              "$ref": "#/$defs/SnapraidDiff"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "unavailable"
            },
            "value": {
              "$ref": "#/$defs/StorageReadFailure"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "value"
          ]
        }
      ]
    },
    "SnapraidDrive": {
      "type": "object",
      "properties": {
        "content": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parity_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SnapraidRole"
        },
        "uuid": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "uuid",
        "role",
        "content",
        "parity_level"
      ]
    },
    "SnapraidPreview": {
      "type": "object",
      "properties": {
        "configuration": {
          "type": "string"
        },
        "desired": {
          "$ref": "#/$defs/SnapraidConfig"
        },
        "media_identity": {
          "$ref": "#/$defs/StorageMediaIdentity"
        },
        "requirements": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ProtectionPathRequirement"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "desired",
        "media_identity",
        "requirements",
        "configuration"
      ]
    },
    "SnapraidRole": {
      "type": "string",
      "enum": [
        "data",
        "parity"
      ]
    },
    "SnapraidSchedule": {
      "type": "object",
      "properties": {
        "scrub_cron": {
          "type": "string"
        },
        "scrub_enabled": {
          "type": "boolean"
        },
        "sync_cron": {
          "type": "string"
        },
        "sync_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "sync_enabled",
        "sync_cron",
        "scrub_enabled",
        "scrub_cron"
      ]
    },
    "SnapraidScrub": {
      "type": "object",
      "properties": {
        "age_days": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "percent": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "percent",
        "age_days"
      ]
    },
    "SnapraidSettings": {
      "type": "object",
      "properties": {
        "autosave": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "blocksize": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "hashsize": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "nohidden": {
          "type": "boolean"
        },
        "prehash": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "blocksize",
        "hashsize",
        "autosave",
        "nohidden",
        "prehash"
      ]
    },
    "SnapraidThresholds": {
      "type": "object",
      "properties": {
        "delete_threshold": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "update_threshold": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "delete_threshold",
        "update_threshold"
      ]
    },
    "StorageBlockDevice": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ]
    },
    "StorageDevice": {
      "type": "object",
      "properties": {
        "filesystem": {
          "$ref": "#/$defs/StorageFilesystem"
        },
        "filesystem_uuid": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "mountpoint": {
          "type": "string",
          "maxLength": 512
        },
        "role": {
          "$ref": "#/$defs/StorageRole"
        },
        "serial": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "filesystem_uuid",
        "filesystem",
        "mountpoint"
      ]
    },
    "StorageFilesystem": {
      "type": "string",
      "enum": [
        "btrfs",
        "exfat",
        "ext2",
        "ext3",
        "ext4",
        "ntfs",
        "vfat",
        "xfs"
      ]
    },
    "StorageFstabEntry": {
      "description": "Only identity/target fields leave the protected reader. Fstab options may\ncontain credentials and are never copied into RPC, plans or HTTP responses.",
      "type": "object",
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorageBlockDevice"
            },
            {
              "type": "null"
            }
          ]
        },
        "filesystem_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed": {
          "type": "boolean"
        },
        "mountpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "mountpoint",
        "managed"
      ]
    },
    "StorageInventory": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageObservedDevice"
          }
        },
        "fstab_digest": {
          "type": "string"
        },
        "fstab_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageFstabEntry"
          }
        },
        "host_root_mount_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mounts_digest": {
          "type": "string"
        },
        "topology_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_root_mount_id",
        "topology_digest",
        "mounts_digest",
        "fstab_digest",
        "fstab_entries",
        "devices"
      ]
    },
    "StorageMediaIdentity": {
      "type": "object",
      "properties": {
        "gid": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2147483647,
          "minimum": 1
        },
        "uid": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2147483647,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "uid",
        "gid"
      ]
    },
    "StorageObservedDevice": {
      "type": "object",
      "properties": {
        "boot_backing": {
          "type": "boolean"
        },
        "device": {
          "$ref": "#/$defs/StorageBlockDevice"
        },
        "filesystem": {
          "type": "string"
        },
        "filesystem_uuid": {
          "type": "string"
        },
        "in_use_as_swap": {
          "type": "boolean"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageObservedMount"
          }
        },
        "serial": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "device",
        "filesystem_uuid",
        "filesystem",
        "boot_backing",
        "mounts"
      ]
    },
    "StorageObservedMount": {
      "type": "object",
      "properties": {
        "filesystem": {
          "type": "string"
        },
        "filesystem_root": {
          "type": "string"
        },
        "mount_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mountpoint": {
          "type": "string"
        },
        "writable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "mountpoint",
        "mount_id",
        "filesystem_root",
        "filesystem",
        "writable"
      ]
    },
    "StorageReadFailure": {
      "type": "object",
      "properties": {
        "detail": {
          "type": "string"
        },
        "reason": {
          "$ref": "#/$defs/StorageReadFailureReason"
        },
        "termination": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorageReadTermination"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "reason",
        "detail"
      ]
    },
    "StorageReadFailureReason": {
      "type": "string",
      "enum": [
        "process_failure",
        "output_limit",
        "malformed_output",
        "source_unavailable"
      ]
    },
    "StorageReadTermination": {
      "description": "Real process termination is preserved independently of parsing or log tags.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "format": "int32"
            },
            "kind": {
              "type": "string",
              "const": "exited"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "signaled"
            },
            "signal": {
              "type": "integer",
              "format": "int32"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "signal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missing_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timed_out"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "output_limit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "io_error"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    },
    "StorageRole": {
      "type": "string",
      "enum": [
        "data",
        "downloads",
        "parity",
        "config_backup"
      ]
    }
  }
}
