{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HealthPolicyDefinition",
  "type": "object",
  "properties": {
    "disabled": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/AlertKind"
      }
    },
    "fail_threshold": {
      "type": "integer",
      "format": "uint8",
      "maximum": 255,
      "minimum": 0
    },
    "required_mounts": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "silences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/HealthPolicySilence"
      }
    }
  },
  "additionalProperties": false,
  "required": [
    "fail_threshold",
    "disabled",
    "required_mounts",
    "silences"
  ],
  "$defs": {
    "AlertKind": {
      "type": "string",
      "enum": [
        "container",
        "smart",
        "mount",
        "snapraid",
        "host"
      ]
    },
    "HealthPolicySilence": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "expires_at": {
          "type": [
            "string",
            "null"
          ]
        },
        "key": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/AlertKind"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "key",
        "created_at",
        "reason"
      ]
    }
  }
}
