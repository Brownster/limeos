{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "MetricHistory",
  "type": "object",
  "properties": {
    "bucket_seconds": {
      "type": "integer",
      "format": "uint32",
      "minimum": 0
    },
    "from": {
      "type": "integer",
      "format": "int64"
    },
    "legacy_history": {
      "type": "string"
    },
    "points": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/MetricPoint"
      }
    },
    "range": {
      "$ref": "#/$defs/HistoryRange"
    },
    "to": {
      "type": "integer",
      "format": "int64"
    }
  },
  "additionalProperties": false,
  "required": [
    "range",
    "from",
    "to",
    "bucket_seconds",
    "points",
    "legacy_history"
  ],
  "$defs": {
    "HistoryRange": {
      "type": "string",
      "enum": [
        "24h",
        "7d",
        "30d"
      ]
    },
    "MetricPoint": {
      "type": "object",
      "properties": {
        "at": {
          "type": "integer",
          "format": "int64"
        },
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "disk_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "memory_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "temperature_celsius": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false,
      "required": [
        "at"
      ]
    }
  }
}
