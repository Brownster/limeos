{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StorageReadFailure",
  "type": "object",
  "properties": {
    "detail": {
      "type": "string"
    },
    "reason": {
      "$ref": "#/$defs/StorageReadFailureReason"
    },
    "termination": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageReadTermination"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "reason",
    "detail"
  ],
  "$defs": {
    "StorageReadFailureReason": {
      "type": "string",
      "enum": [
        "process_failure",
        "output_limit",
        "malformed_output",
        "source_unavailable"
      ]
    },
    "StorageReadTermination": {
      "description": "Real process termination is preserved independently of parsing or log tags.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "format": "int32"
            },
            "kind": {
              "type": "string",
              "const": "exited"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "signaled"
            },
            "signal": {
              "type": "integer",
              "format": "int32"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "signal"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "missing_binary"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "timed_out"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "output_limit"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "io_error"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        }
      ]
    }
  }
}
