      "Role": {
        "enum": [
          "viewer",
          "media_requester",
          "operator",
          "administrator"
        ],
        "type": "string"
      }
    },
    "securitySchemes": {
      "session": {
        "in": "cookie",
        "name": "__Host-limeos",
