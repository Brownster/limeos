      "ErrorCode": {
        "enum": [
          "invalid_input",
          "unauthenticated",
          "forbidden",
          "conflict",
          "expired",
          "overloaded",
          "unavailable",
          "corrupt_configuration",
          "state_not_durable",
          "not_found"
