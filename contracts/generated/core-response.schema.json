{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "int64"
        },
        "ready": {
          "type": "boolean"
        },
        "response": {
          "type": "string",
          "const": "health"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "version",
        "generation",
        "schema_version",
        "ready"
      ]
    },
    {
      "type": "object",
      "properties": {
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "response": {
          "type": "string",
          "const": "bootstrap"
        },
        "token": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "token",
        "expires_at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "const": "enrolled"
        }
      },
      "additionalProperties": false,
      "required": [
        "response"
      ]
    },
    {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "const": "authorized"
        }
      },
      "additionalProperties": false,
      "required": [
        "response"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "restart_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "restart_job"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "id",
        "state",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "container_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "container_job"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "id",
        "state",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        },
        "response": {
          "type": "string",
          "const": "container_logs"
        },
        "text": {
          "type": "string",
          "maxLength": 24576
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "resource",
        "text",
        "truncated"
      ]
    },
    {
      "type": "object",
      "properties": {
        "audit_id": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "response": {
          "type": "string",
          "const": "error"
        },
        "retry": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "code",
        "message",
        "retry",
        "audit_id"
      ]
    }
  ],
  "$defs": {
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "unauthenticated",
        "forbidden",
        "conflict",
        "expired",
        "overloaded",
        "unavailable",
        "corrupt_configuration",
        "state_not_durable",
        "not_found"
      ]
    },
    "JobState": {
      "type": "string",
      "enum": [
        "planned",
        "waiting_approval",
        "queued",
        "running",
        "verifying",
        "succeeded",
        "failed",
        "canceled",
        "precondition_changed",
        "outcome_unknown",
        "needs_intervention"
      ]
    }
  }
}
