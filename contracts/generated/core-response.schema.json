{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "degraded": {
          "description": "Subsystems not working as they should right now; an entry clears as\nsoon as its subsystem recovers. Core keeps serving requests while any\nis listed; an empty list is healthy.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DegradedSubsystem"
          }
        },
        "generation": {
          "type": "integer",
          "format": "int64"
        },
        "ready": {
          "type": "boolean"
        },
        "response": {
          "type": "string",
          "const": "health"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "version",
        "generation",
        "schema_version",
        "ready",
        "degraded"
      ]
    },
    {
      "type": "object",
      "properties": {
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "response": {
          "type": "string",
          "const": "bootstrap"
        },
        "token": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "token",
        "expires_at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "const": "enrolled"
        }
      },
      "additionalProperties": false,
      "required": [
        "response"
      ]
    },
    {
      "type": "object",
      "properties": {
        "imported": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "response": {
          "type": "string",
          "const": "legacy_users_imported"
        },
        "skipped_existing": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "imported",
        "skipped_existing"
      ]
    },
    {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "const": "authorized"
        }
      },
      "additionalProperties": false,
      "required": [
        "response"
      ]
    },
    {
      "description": "`GET /api/v1/jobs/{id}/resolution`. Evidence is fresh on every read and its\ndigest binds a later decision to exactly what was shown.",
      "type": "object",
      "properties": {
        "allowed": {
          "description": "Declarations the evidence supports now. `accepted_divergence` is always\nlisted while the job is awaiting resolution.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeclaredOutcome"
          }
        },
        "evidence_digest": {
          "description": "Present exactly when `targets` is. Send it back unchanged in the POST.",
          "type": [
            "string",
            "null"
          ]
        },
        "job": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResolveKind"
        },
        "members": {
          "description": "The executor's recorded per-target outcomes; absent before any receipt.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ResolutionMember"
          }
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "pending": {
          "description": "A request that is recorded but not yet completed.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "description": "The completed record, once resolved.",
          "anyOf": [
            {
              "$ref": "#/$defs/JobResolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "type": "string",
          "const": "resolution"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "targets": {
          "description": "Empty when the job is not awaiting resolution or is already resolved.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolutionTargetView"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "job",
        "state",
        "kind",
        "operation",
        "targets",
        "allowed"
      ]
    },
    {
      "type": "object",
      "properties": {
        "blocking": {
          "description": "Container IDs whose measured state blocks the declaration.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "message": {
          "type": "string"
        },
        "resolution": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobResolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "type": "string",
          "const": "resolved"
        },
        "status": {
          "$ref": "#/$defs/ResolveStatus"
        },
        "view": {
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionView"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "status",
        "message",
        "blocking"
      ]
    },
    {
      "description": "One bounded listing, oldest job first.",
      "type": "object",
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/OperatorJob"
          }
        },
        "matching": {
          "description": "Every job in the requested states; more than `jobs.len()` means the\nlisting was cut at its limit.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "response": {
          "type": "string",
          "const": "jobs"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "jobs",
        "matching"
      ]
    },
    {
      "description": "The answer to one cancellation on the owner's behalf.",
      "type": "object",
      "properties": {
        "family": {
          "$ref": "#/$defs/JobFamily"
        },
        "job": {
          "type": "string"
        },
        "outcome": {
          "$ref": "#/$defs/CancelOutcome"
        },
        "refusal": {
          "description": "Present exactly when `outcome` is `refused`.",
          "anyOf": [
            {
              "$ref": "#/$defs/CancelRefusal"
            },
            {
              "type": "null"
            }
          ]
        },
        "response": {
          "type": "string",
          "const": "job_canceled"
        },
        "state": {
          "description": "The job's state after the call.",
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "job",
        "family",
        "state",
        "outcome"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "restart_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "restart_job"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "id",
        "state",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "container_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "container_job"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "id",
        "state",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        },
        "response": {
          "type": "string",
          "const": "container_logs"
        },
        "text": {
          "type": "string",
          "maxLength": 24576
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "resource",
        "text",
        "truncated"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ComposePlan"
        },
        "response": {
          "type": "string",
          "const": "compose_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "audit_id": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "response": {
          "type": "string",
          "const": "error"
        },
        "retry": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "code",
        "message",
        "retry",
        "audit_id"
      ]
    }
  ],
  "$defs": {
    "CancelOutcome": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "refused"
          ]
        },
        {
          "description": "The job moved from `queued` to `canceled` now.",
          "type": "string",
          "const": "canceled"
        },
        {
          "description": "The job was already `canceled`; nothing was written.",
          "type": "string",
          "const": "already_canceled"
        }
      ]
    },
    "CancelRefusal": {
      "description": "Why core refused to cancel a job on its owner's behalf. Nothing changed.",
      "oneOf": [
        {
          "description": "The job is not queued: it was dispatched (an execute may have been\nsent, so cancelling cannot prove nothing happened), or it has already\nsettled. A held job is settled by `limeosctl job resolve`.",
          "type": "string",
          "const": "not_queued"
        },
        {
          "description": "Automation observations are cancelled only by pausing their schedule:\nstartup refuses a store holding a cancellation of the current schedule\nrevision that no pause explains.",
          "type": "string",
          "const": "pause_schedule_instead"
        }
      ]
    },
    "ComposeDevice": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ]
    },
    "ComposeFile": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/ComposeFileName"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ]
    },
    "ComposeFileName": {
      "type": "string",
      "enum": [
        "compose.yaml",
        "compose.yml",
        "docker-compose.yaml",
        "docker-compose.yml"
      ]
    },
    "ComposeImpact": {
      "type": "object",
      "properties": {
        "elevated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposePrivilege"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeServiceChange"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "services",
        "elevated"
      ]
    },
    "ComposeMount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "volume"
            },
            "name": {
              "type": "string"
            },
            "read_only": {
              "type": "boolean"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "target",
            "read_only"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bind"
            },
            "read_only": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "target",
            "read_only"
          ]
        }
      ]
    },
    "ComposePlan": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/ComposeProject"
        },
        "catalog_digest": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "desired": {
          "$ref": "#/$defs/ComposeProject"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/ComposeImpact"
        },
        "managed_file": {
          "type": "string"
        },
        "operator_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeFile"
          }
        },
        "principal": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ComposeSelection"
        },
        "template_digest": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "catalog_digest",
        "template_digest",
        "selection",
        "operator_files",
        "managed_file",
        "before",
        "desired",
        "impact",
        "created_at",
        "expires_at"
      ]
    },
    "ComposePort": {
      "type": "object",
      "properties": {
        "host_ip": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/PortProtocol"
        },
        "published": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "host_ip",
        "published",
        "target",
        "protocol"
      ]
    },
    "ComposePrivilege": {
      "type": "string",
      "enum": [
        "privileged",
        "host_mount",
        "device",
        "docker_socket",
        "host_network"
      ]
    },
    "ComposeProject": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeService"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "services"
      ]
    },
    "ComposeRestart": {
      "type": "string",
      "enum": [
        "no",
        "always",
        "on-failure",
        "unless-stopped"
      ]
    },
    "ComposeSelection": {
      "type": "object",
      "properties": {
        "stack": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stack",
        "template"
      ]
    },
    "ComposeService": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeDevice"
          }
        },
        "host_network": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeMount"
          }
        },
        "name": {
          "type": "string"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposePort"
          }
        },
        "privileged": {
          "type": "boolean"
        },
        "restart": {
          "$ref": "#/$defs/ComposeRestart"
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeUser"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "image",
        "restart",
        "ports",
        "mounts",
        "devices",
        "privileged",
        "host_network"
      ]
    },
    "ComposeServiceChange": {
      "type": "object",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeService"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeService"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "ComposeUser": {
      "type": "object",
      "properties": {
        "gid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "uid",
        "gid"
      ]
    },
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "DeclaredOutcome": {
      "description": "What the administrator declares about the job. Only `AcceptedDivergence`\nrests on the operator's word; the other two are checked against evidence.",
      "oneOf": [
        {
          "description": "The intended end state is present on every target.",
          "type": "string",
          "const": "verified_done"
        },
        {
          "description": "Nothing took effect: every target still equals the plan's `expected`.",
          "type": "string",
          "const": "not_done"
        },
        {
          "description": "The present state differs from both before and intended; accepted.",
          "type": "string",
          "const": "accepted_divergence"
        }
      ]
    },
    "DegradedDetail": {
      "type": "object",
      "properties": {
        "code": {
          "description": "The error that describes the current state: for the observation\nruntime, the one that ended its latest run; for the storage reader\nand the store, `unavailable`.",
          "$ref": "#/$defs/ErrorCode"
        },
        "count": {
          "description": "For the observation runtime, failures in the current run; it restarts\nafter a longer wait each time. For the storage reader, reads stuck.\nFor the store, calls waiting for its writer.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "since": {
          "description": "When the current state began (Unix seconds): for the storage reader,\nwhen its oldest stuck read was abandoned; for the store, when its\nwriter started the item it is still on.",
          "type": "integer",
          "format": "int64"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "since",
        "count"
      ]
    },
    "DegradedSubsystem": {
      "type": "object",
      "properties": {
        "detail": {
          "description": "What is wrong and since when. Given to an authenticated caller and to\n`limeosctl status`; the unauthenticated health check names only the\nsubsystem.",
          "anyOf": [
            {
              "$ref": "#/$defs/DegradedDetail"
            },
            {
              "type": "null"
            }
          ]
        },
        "subsystem": {
          "$ref": "#/$defs/Subsystem"
        }
      },
      "additionalProperties": false,
      "required": [
        "subsystem"
      ]
    },
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "invalid_input",
            "unauthenticated",
            "forbidden",
            "conflict",
            "expired",
            "overloaded",
            "unavailable",
            "storage_mount_limit",
            "corrupt_configuration",
            "state_not_durable",
            "not_found"
          ]
        },
        {
          "description": "The container executor refused an execute request for an action it\nholds no receipt for, because the plan expires at or below its prune\nwatermark: a receipt for it may have been pruned, so the executor can\nno longer tell whether the action already ran. Never retried as an\neffect. Fresh plans meet it only after the clock stepped back by more\nthan the receipt retention period, until the clock catches up.",
          "type": "string",
          "const": "beyond_receipt_history"
        },
        {
          "description": "The container executor refused an execute request because a container\nit would act on has spent its effect budget (ADR 0013): refused before\nthe store writes any receipt for the action, so nothing ran or can run\nfor it. Settled as refused, never retried as an effect.",
          "type": "string",
          "const": "rate_limited"
        }
      ]
    },
    "ExecutionState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "prepared",
            "effect_accepted",
            "verified",
            "precondition_changed",
            "outcome_unknown"
          ]
        },
        {
          "description": "Stack aggregate only: every sent member is verified and every other\nmember is provably unsent. Terminal; never reported as success.",
          "type": "string",
          "const": "partly_done"
        }
      ]
    },
    "JobFamily": {
      "description": "The job families core can queue, one per group of intent operations.",
      "oneOf": [
        {
          "description": "`container_restart`, `container_start`, `container_stop`.",
          "type": "string",
          "const": "container"
        },
        {
          "description": "`stack_restart`, `stack_start`, `stack_stop`.",
          "type": "string",
          "const": "stack"
        },
        {
          "description": "`storage_prepare_targets`.",
          "type": "string",
          "const": "storage_targets"
        },
        {
          "description": "`storage_mount`.",
          "type": "string",
          "const": "storage_mount"
        },
        {
          "description": "`automation_observe_health`.",
          "type": "string",
          "const": "automation_observation"
        },
        {
          "description": "`health_probe`.",
          "type": "string",
          "const": "health_probe"
        },
        {
          "description": "`backup_prepare_private`.",
          "type": "string",
          "const": "backup_preparation"
        }
      ]
    },
    "JobResolution": {
      "description": "The completed audit record (step 3). Additional to, never replacing, the\njob's `outcome_unknown`/`needs_intervention` history.",
      "type": "object",
      "properties": {
        "declared": {
          "$ref": "#/$defs/DeclaredOutcome"
        },
        "evidence": {
          "$ref": "#/$defs/ResolutionEvidence"
        },
        "evidence_digest": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "requested_at": {
          "type": "integer",
          "format": "int64"
        },
        "resolved_at": {
          "type": "integer",
          "format": "int64"
        },
        "resolved_by": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "job",
        "resolved_by",
        "declared",
        "reason",
        "evidence",
        "evidence_digest",
        "requested_at",
        "resolved_at"
      ]
    },
    "JobState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "planned",
            "waiting_approval",
            "queued",
            "running",
            "verifying",
            "succeeded",
            "failed",
            "canceled",
            "precondition_changed",
            "outcome_unknown",
            "needs_intervention"
          ]
        },
        {
          "description": "An administrator settled an uncertain job on evidence. Terminal and\nlock-releasing; the original job, plan and receipts stay unchanged.",
          "type": "string",
          "const": "resolved"
        }
      ]
    },
    "OperatorJob": {
      "description": "One job as the host operator sees it. Names the job, its owner and what\nit would act on; never the plan body, evidence or receipts.",
      "type": "object",
      "properties": {
        "claims": {
          "description": "Resources the job claims when dispatched (its `job_resources` rows,\nthe headline resource included). A queued job holds none of them yet.",
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "created_at": {
          "description": "Unix seconds of the job's first recorded event (when it was queued);\n0 when none survives.",
          "type": "integer",
          "format": "int64"
        },
        "deadline": {
          "description": "Unix seconds after which a queued job is never dispatched: its approved\nplan's expiry, or a health probe's deadline. Backup preparation stores\nits plan's expiry here but has no dispatcher that reads it.",
          "type": "integer",
          "format": "int64"
        },
        "family": {
          "$ref": "#/$defs/JobFamily"
        },
        "job": {
          "type": "string"
        },
        "operation": {
          "description": "The intent's operation tag, for example `container_restart`.",
          "type": "string"
        },
        "owner": {
          "description": "Username of the principal that queued the job.",
          "type": "string"
        },
        "resolution_open": {
          "description": "An administrator's resolution request is recorded and not completed.",
          "type": "boolean"
        },
        "resource": {
          "description": "The job's headline resource, for example `container:<id>`,\n`stack:<name>`, `storage:configuration`.",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "job",
        "owner",
        "family",
        "operation",
        "state",
        "resource",
        "claims",
        "created_at",
        "deadline",
        "resolution_open"
      ]
    },
    "PortProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ]
    },
    "ResolutionEvidence": {
      "description": "Evidence for exactly the job's targets, sorted by container ID. Core and\nexecutor build it with the same function so their digests agree.",
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolutionTarget"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "targets"
      ]
    },
    "ResolutionMember": {
      "description": "One target's outcome as the executor recorded it in the job's receipt. For\na container job there is exactly one; for a stack, one per member.",
      "type": "object",
      "properties": {
        "container": {
          "description": "Full container ID, without the `container:` prefix.",
          "type": "string"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/ExecutionState"
        }
      },
      "additionalProperties": false,
      "required": [
        "container",
        "state"
      ]
    },
    "ResolutionRequest": {
      "description": "A recorded request (step 1). The job stays locked until the executor has\nconfirmed and core has completed it.",
      "type": "object",
      "properties": {
        "declared": {
          "$ref": "#/$defs/DeclaredOutcome"
        },
        "evidence": {
          "$ref": "#/$defs/ResolutionEvidence"
        },
        "evidence_digest": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "requested_at": {
          "type": "integer",
          "format": "int64"
        },
        "resolved_by": {
          "description": "Administrator principal ID.",
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "job",
        "resolved_by",
        "declared",
        "reason",
        "evidence",
        "evidence_digest",
        "requested_at"
      ]
    },
    "ResolutionTarget": {
      "description": "One target's fresh, read-only measurement against the plan. A container\nthat no longer exists is recorded with empty `image` and `started_at`,\n`running` false and both flags false (see `is_absent`).",
      "type": "object",
      "properties": {
        "container": {
          "description": "Full container ID, without the `container:` prefix.",
          "type": "string"
        },
        "image": {
          "type": "string"
        },
        "intended_state_reached": {
          "description": "The plan's action is proven by this target's post-state.",
          "type": "boolean"
        },
        "matches_expected": {
          "description": "ID, start time, image and running state all equal the plan's `expected`.",
          "type": "boolean"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "container",
        "running",
        "started_at",
        "image",
        "matches_expected",
        "intended_state_reached"
      ]
    },
    "ResolutionTargetView": {
      "description": "One target, plan against fresh measurement.",
      "type": "object",
      "properties": {
        "expected": {
          "description": "What the plan expected before the action.",
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "measured": {
          "description": "What a read-only inspection found just now.",
          "$ref": "#/$defs/ResolutionTarget"
        }
      },
      "additionalProperties": false,
      "required": [
        "expected",
        "measured"
      ]
    },
    "ResolutionView": {
      "description": "`GET /api/v1/jobs/{id}/resolution`. Evidence is fresh on every read and its\ndigest binds a later decision to exactly what was shown.",
      "type": "object",
      "properties": {
        "allowed": {
          "description": "Declarations the evidence supports now. `accepted_divergence` is always\nlisted while the job is awaiting resolution.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeclaredOutcome"
          }
        },
        "evidence_digest": {
          "description": "Present exactly when `targets` is. Send it back unchanged in the POST.",
          "type": [
            "string",
            "null"
          ]
        },
        "job": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResolveKind"
        },
        "members": {
          "description": "The executor's recorded per-target outcomes; absent before any receipt.",
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/ResolutionMember"
          }
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "pending": {
          "description": "A request that is recorded but not yet completed.",
          "anyOf": [
            {
              "$ref": "#/$defs/ResolutionRequest"
            },
            {
              "type": "null"
            }
          ]
        },
        "resolution": {
          "description": "The completed record, once resolved.",
          "anyOf": [
            {
              "$ref": "#/$defs/JobResolution"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "$ref": "#/$defs/JobState"
        },
        "targets": {
          "description": "Empty when the job is not awaiting resolution or is already resolved.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ResolutionTargetView"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "job",
        "state",
        "kind",
        "operation",
        "targets",
        "allowed"
      ]
    },
    "ResolveKind": {
      "description": "Which executor table holds the action: one container or a whole stack.",
      "type": "string",
      "enum": [
        "container",
        "stack"
      ]
    },
    "ResolveStatus": {
      "oneOf": [
        {
          "description": "HTTP 200. The executor and core both released the job.",
          "type": "string",
          "const": "resolved"
        },
        {
          "description": "HTTP 202. The request is recorded and the job stays held; the executor\nwas unreachable or its answer was lost. Core retries on its own, and the\nsame POST may be repeated.",
          "type": "string",
          "const": "pending"
        },
        {
          "description": "HTTP 409. The state changed since the evidence was shown. Nothing is\nheld; `view` carries the fresh evidence.",
          "type": "string",
          "const": "stale_evidence"
        },
        {
          "description": "HTTP 409. The evidence does not support `declared`; `blocking` names the\ntargets that differ and `view` carries the evidence.",
          "type": "string",
          "const": "unsupported_declaration"
        }
      ]
    },
    "Subsystem": {
      "description": "A part of the service that can fail on its own while core keeps serving.",
      "oneOf": [
        {
          "description": "The 1 Hz health-observation and automation runtime.",
          "type": "string",
          "const": "observation_runtime"
        },
        {
          "description": "The storage reader has a storage read stuck past its deadline (a\nfailing disk, typically); it refuses storage inventory until the read\nreturns and serves everything else.",
          "type": "string",
          "const": "storage_reader"
        },
        {
          "description": "The store's single writer thread has been on one item for too long\n(a hung fsync, a lock held from outside), or did not answer a probe\nin time. Requests that need the store fail at their deadline\nmeanwhile, and core reports itself not ready.",
          "type": "string",
          "const": "store"
        }
      ]
    }
  }
}
