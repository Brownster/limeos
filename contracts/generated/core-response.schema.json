{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreResponse",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "format": "int64"
        },
        "ready": {
          "type": "boolean"
        },
        "response": {
          "type": "string",
          "const": "health"
        },
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "version",
        "generation",
        "schema_version",
        "ready"
      ]
    },
    {
      "type": "object",
      "properties": {
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "response": {
          "type": "string",
          "const": "bootstrap"
        },
        "token": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "token",
        "expires_at"
      ]
    },
    {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "const": "enrolled"
        }
      },
      "additionalProperties": false,
      "required": [
        "response"
      ]
    },
    {
      "type": "object",
      "properties": {
        "response": {
          "type": "string",
          "const": "authorized"
        }
      },
      "additionalProperties": false,
      "required": [
        "response"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "restart_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "restart_job"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "id",
        "state",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "container_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "response": {
          "type": "string",
          "const": "container_job"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "id",
        "state",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        },
        "response": {
          "type": "string",
          "const": "container_logs"
        },
        "text": {
          "type": "string",
          "maxLength": 24576
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "resource",
        "text",
        "truncated"
      ]
    },
    {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ComposePlan"
        },
        "response": {
          "type": "string",
          "const": "compose_plan"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "plan",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "audit_id": {
          "type": "string"
        },
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "message": {
          "type": "string"
        },
        "response": {
          "type": "string",
          "const": "error"
        },
        "retry": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "response",
        "code",
        "message",
        "retry",
        "audit_id"
      ]
    }
  ],
  "$defs": {
    "ComposeDevice": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ]
    },
    "ComposeFile": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/ComposeFileName"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ]
    },
    "ComposeFileName": {
      "type": "string",
      "enum": [
        "compose.yaml",
        "compose.yml",
        "docker-compose.yaml",
        "docker-compose.yml"
      ]
    },
    "ComposeImpact": {
      "type": "object",
      "properties": {
        "elevated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposePrivilege"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeServiceChange"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "services",
        "elevated"
      ]
    },
    "ComposeMount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "volume"
            },
            "name": {
              "type": "string"
            },
            "read_only": {
              "type": "boolean"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "target",
            "read_only"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bind"
            },
            "read_only": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "target",
            "read_only"
          ]
        }
      ]
    },
    "ComposePlan": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/ComposeProject"
        },
        "catalog_digest": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "desired": {
          "$ref": "#/$defs/ComposeProject"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/ComposeImpact"
        },
        "managed_file": {
          "type": "string"
        },
        "operator_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeFile"
          }
        },
        "principal": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ComposeSelection"
        },
        "template_digest": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "catalog_digest",
        "template_digest",
        "selection",
        "operator_files",
        "managed_file",
        "before",
        "desired",
        "impact",
        "created_at",
        "expires_at"
      ]
    },
    "ComposePort": {
      "type": "object",
      "properties": {
        "host_ip": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/PortProtocol"
        },
        "published": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "host_ip",
        "published",
        "target",
        "protocol"
      ]
    },
    "ComposePrivilege": {
      "type": "string",
      "enum": [
        "privileged",
        "host_mount",
        "device",
        "docker_socket",
        "host_network"
      ]
    },
    "ComposeProject": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeService"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "services"
      ]
    },
    "ComposeRestart": {
      "type": "string",
      "enum": [
        "no",
        "always",
        "on-failure",
        "unless-stopped"
      ]
    },
    "ComposeSelection": {
      "type": "object",
      "properties": {
        "stack": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stack",
        "template"
      ]
    },
    "ComposeService": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeDevice"
          }
        },
        "host_network": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeMount"
          }
        },
        "name": {
          "type": "string"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposePort"
          }
        },
        "privileged": {
          "type": "boolean"
        },
        "restart": {
          "$ref": "#/$defs/ComposeRestart"
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeUser"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "image",
        "restart",
        "ports",
        "mounts",
        "devices",
        "privileged",
        "host_network"
      ]
    },
    "ComposeServiceChange": {
      "type": "object",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeService"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeService"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "ComposeUser": {
      "type": "object",
      "properties": {
        "gid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "uid",
        "gid"
      ]
    },
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "unauthenticated",
        "forbidden",
        "conflict",
        "expired",
        "overloaded",
        "unavailable",
        "storage_mount_limit",
        "corrupt_configuration",
        "state_not_durable",
        "not_found"
      ]
    },
    "JobState": {
      "type": "string",
      "enum": [
        "planned",
        "waiting_approval",
        "queued",
        "running",
        "verifying",
        "succeeded",
        "failed",
        "canceled",
        "precondition_changed",
        "outcome_unknown",
        "needs_intervention"
      ]
    },
    "PortProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ]
    }
  }
}
