{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Receipt",
  "type": "object",
  "properties": {
    "container_storage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContainerStorageInventory"
        },
        {
          "type": "null"
        }
      ]
    },
    "error": {
      "anyOf": [
        {
          "$ref": "#/$defs/ErrorCode"
        },
        {
          "type": "null"
        }
      ]
    },
    "inspection": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "logs": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContainerLogs"
        },
        {
          "type": "null"
        }
      ]
    },
    "mounted_storage": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageMountedSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "observations": {
      "anyOf": [
        {
          "$ref": "#/$defs/ObservationBatch"
        },
        {
          "type": "null"
        }
      ]
    },
    "ready": {
      "type": "boolean"
    },
    "restart": {
      "anyOf": [
        {
          "$ref": "#/$defs/ContainerReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageInventory"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage_mount": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageMountReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage_mount_catalog": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageMountCatalog"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage_mount_inspection": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageMountInspection"
        },
        {
          "type": "null"
        }
      ]
    },
    "storage_targets": {
      "anyOf": [
        {
          "$ref": "#/$defs/StorageTargetSnapshot"
        },
        {
          "type": "null"
        }
      ]
    },
    "target_preparation": {
      "anyOf": [
        {
          "$ref": "#/$defs/TargetPreparationReceipt"
        },
        {
          "type": "null"
        }
      ]
    },
    "version": {
      "type": "integer",
      "format": "uint16",
      "maximum": 65535,
      "minimum": 0
    }
  },
  "additionalProperties": false,
  "required": [
    "version",
    "ready"
  ],
  "$defs": {
    "Availability": {
      "type": "string",
      "enum": [
        "loading",
        "fresh",
        "stale",
        "unavailable"
      ]
    },
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerLogs": {
      "type": "object",
      "properties": {
        "resource": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 24576
        },
        "truncated": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "text",
        "truncated"
      ]
    },
    "ContainerReceipt": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "plan_digest": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExecutionState"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "plan_digest",
        "before",
        "state"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "ContainerStorageConsumer": {
      "type": "object",
      "properties": {
        "container": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerStorageMount"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "container",
        "mounts"
      ]
    },
    "ContainerStorageInventory": {
      "type": "object",
      "properties": {
        "containers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerStorageConsumer"
          }
        },
        "engine_id": {
          "type": "string"
        },
        "observed_at": {
          "type": "integer",
          "format": "int64"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "engine_id",
        "observed_at",
        "containers"
      ]
    },
    "ContainerStorageMount": {
      "type": "object",
      "properties": {
        "destination": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/ContainerStorageSource"
        },
        "writable": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "destination",
        "writable"
      ]
    },
    "ContainerStorageSource": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bind"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path"
          ]
        },
        {
          "type": "object",
          "properties": {
            "driver": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "volume"
            },
            "name": {
              "type": "string"
            },
            "path": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "path",
            "name",
            "driver"
          ]
        }
      ]
    },
    "DirectoryIdentity": {
      "type": "object",
      "properties": {
        "gid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "mount_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor",
        "mount_id",
        "inode",
        "mode",
        "uid",
        "gid"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "unauthenticated",
        "forbidden",
        "conflict",
        "expired",
        "overloaded",
        "unavailable",
        "storage_mount_limit",
        "corrupt_configuration",
        "state_not_durable",
        "not_found"
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "prepared",
        "effect_accepted",
        "verified",
        "precondition_changed",
        "outcome_unknown"
      ]
    },
    "Freshness": {
      "type": "object",
      "properties": {
        "max_age_seconds": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "sampled_at": {
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "state": {
          "$ref": "#/$defs/Availability"
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "state",
        "max_age_seconds",
        "warnings"
      ]
    },
    "HostMetrics": {
      "type": "object",
      "properties": {
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "disk_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "load_one": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "memory_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "temperature_celsius": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "uptime_seconds": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        }
      },
      "additionalProperties": false
    },
    "MountEffectQuiescence": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "not_launched"
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "helper": {
              "anyOf": [
                {
                  "$ref": "#/$defs/MountHelperIdentity"
                },
                {
                  "type": "null"
                }
              ]
            },
            "state": {
              "type": "string",
              "const": "pending"
            }
          },
          "additionalProperties": false,
          "required": [
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "helper": {
              "$ref": "#/$defs/MountHelperIdentity"
            },
            "outcome": {
              "$ref": "#/$defs/MountHelperOutcome"
            },
            "state": {
              "type": "string",
              "const": "reaped"
            }
          },
          "additionalProperties": false,
          "required": [
            "state",
            "helper",
            "outcome"
          ]
        }
      ]
    },
    "MountExecutionState": {
      "type": "string",
      "enum": [
        "prepared",
        "effect_accepted",
        "verified",
        "precondition_changed",
        "outcome_unknown"
      ]
    },
    "MountHelperIdentity": {
      "description": "Authenticated receipt facts only. Construction of their genuine process owner\nand confirmation that no descendant/helper can still run belong to supervision.",
      "type": "object",
      "properties": {
        "cgroup": {
          "type": "string"
        },
        "image_digest": {
          "type": "string"
        },
        "mount_namespace_inode": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "start_time_ticks": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "pid",
        "start_time_ticks",
        "mount_namespace_inode",
        "cgroup",
        "image_digest"
      ]
    },
    "MountHelperOutcome": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "code": {
              "type": "integer",
              "format": "int32"
            },
            "status": {
              "type": "string",
              "const": "exited"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "code"
          ]
        },
        {
          "type": "object",
          "properties": {
            "signal": {
              "type": "integer",
              "format": "int32"
            },
            "status": {
              "type": "string",
              "const": "signaled"
            }
          },
          "additionalProperties": false,
          "required": [
            "status",
            "signal"
          ]
        }
      ]
    },
    "ObservationBatch": {
      "type": "object",
      "properties": {
        "host": {
          "anyOf": [
            {
              "$ref": "#/$defs/HostMetrics"
            },
            {
              "type": "null"
            }
          ]
        },
        "resources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Resource"
          }
        },
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Freshness"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "resources",
        "sources"
      ]
    },
    "PreparationState": {
      "type": "string",
      "enum": [
        "prepared",
        "verified",
        "precondition_changed",
        "outcome_unknown"
      ]
    },
    "Resource": {
      "type": "object",
      "properties": {
        "cpu_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "filesystem": {
          "type": [
            "string",
            "null"
          ]
        },
        "health": {
          "type": [
            "string",
            "null"
          ]
        },
        "id": {
          "type": "string"
        },
        "identity": {
          "type": [
            "string",
            "null"
          ]
        },
        "image": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/ResourceKind"
        },
        "memory_percent": {
          "type": [
            "number",
            "null"
          ],
          "format": "double"
        },
        "mountpoint": {
          "type": [
            "string",
            "null"
          ]
        },
        "name": {
          "type": "string"
        },
        "parent": {
          "type": [
            "string",
            "null"
          ]
        },
        "size_bytes": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "status": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "name",
        "status",
        "source"
      ]
    },
    "ResourceKind": {
      "type": "string",
      "enum": [
        "disk",
        "partition",
        "pool",
        "container",
        "stack"
      ]
    },
    "Source": {
      "type": "string",
      "enum": [
        "host",
        "storage",
        "pools",
        "docker",
        "history"
      ]
    },
    "StorageBlockDevice": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ]
    },
    "StorageContract": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageDevice"
          },
          "maxItems": 32,
          "minItems": 1
        },
        "locations": {
          "$ref": "#/$defs/StorageLocations"
        },
        "media_identity": {
          "$ref": "#/$defs/StorageMediaIdentity"
        },
        "profile": {
          "$ref": "#/$defs/StorageProfile"
        },
        "schema_version": {
          "$ref": "#/$defs/StorageSchemaVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "profile",
        "media_identity",
        "locations",
        "devices"
      ]
    },
    "StorageDevice": {
      "type": "object",
      "properties": {
        "filesystem": {
          "$ref": "#/$defs/StorageFilesystem"
        },
        "filesystem_uuid": {
          "type": "string",
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
        },
        "id": {
          "type": "string",
          "maxLength": 64,
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9_-]*$"
        },
        "mountpoint": {
          "type": "string",
          "maxLength": 512
        },
        "role": {
          "$ref": "#/$defs/StorageRole"
        },
        "serial": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "filesystem_uuid",
        "filesystem",
        "mountpoint"
      ]
    },
    "StorageFilesystem": {
      "type": "string",
      "enum": [
        "btrfs",
        "exfat",
        "ext2",
        "ext3",
        "ext4",
        "ntfs",
        "vfat",
        "xfs"
      ]
    },
    "StorageFstabEntry": {
      "description": "Only identity/target fields leave the protected reader. Fstab options may\ncontain credentials and are never copied into RPC, plans or HTTP responses.",
      "type": "object",
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorageBlockDevice"
            },
            {
              "type": "null"
            }
          ]
        },
        "filesystem_uuid": {
          "type": [
            "string",
            "null"
          ]
        },
        "managed": {
          "type": "boolean"
        },
        "mountpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "mountpoint",
        "managed"
      ]
    },
    "StorageInventory": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageObservedDevice"
          }
        },
        "fstab_digest": {
          "type": "string"
        },
        "fstab_entries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageFstabEntry"
          }
        },
        "host_root_mount_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "mounts_digest": {
          "type": "string"
        },
        "topology_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "host_root_mount_id",
        "topology_digest",
        "mounts_digest",
        "fstab_digest",
        "fstab_entries",
        "devices"
      ]
    },
    "StorageLocations": {
      "type": "object",
      "properties": {
        "application_config_host": {
          "type": "string",
          "maxLength": 512
        },
        "backup_host": {
          "type": "string",
          "maxLength": 512
        },
        "config_container": {
          "type": "string",
          "pattern": "^/config$"
        },
        "downloads_container": {
          "type": "string",
          "pattern": "^/data/downloads$"
        },
        "downloads_host": {
          "type": "string",
          "maxLength": 512
        },
        "media_container": {
          "type": "string",
          "pattern": "^/data/media$"
        },
        "media_host": {
          "type": "string",
          "maxLength": 512
        }
      },
      "additionalProperties": false,
      "required": [
        "media_host",
        "downloads_host",
        "application_config_host",
        "backup_host",
        "media_container",
        "downloads_container",
        "config_container"
      ]
    },
    "StorageMediaIdentity": {
      "type": "object",
      "properties": {
        "gid": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2147483647,
          "minimum": 1
        },
        "uid": {
          "type": "integer",
          "format": "uint32",
          "maximum": 2147483647,
          "minimum": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "uid",
        "gid"
      ]
    },
    "StorageMountCatalog": {
      "description": "Protected configuration choices, independent of live readiness or authority.",
      "type": "object",
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageDevice"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "targets"
      ]
    },
    "StorageMountEffectPlan": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "consumer_digest": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "device": {
          "$ref": "#/$defs/StorageDevice"
        },
        "expected": {
          "$ref": "#/$defs/StorageInventory"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "operation": {
          "type": "string"
        },
        "physical_devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StorageBlockDevice"
          }
        },
        "target": {
          "$ref": "#/$defs/TargetEvidence"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "operation",
        "action",
        "device",
        "expected",
        "target",
        "physical_devices",
        "consumer_digest",
        "created_at",
        "expires_at"
      ]
    },
    "StorageMountInspection": {
      "description": "A protected reader's past facts. Empty-target/complete-consumer proofs are opaque\nretained owners held by the executor, and cannot be reconstructed from this DTO.",
