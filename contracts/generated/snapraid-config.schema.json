{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SnapraidConfig",
  "type": "object",
  "properties": {
    "drives": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/SnapraidDrive"
      }
    },
    "enabled": {
      "type": "boolean"
    },
    "excludes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schedule": {
      "$ref": "#/$defs/SnapraidSchedule"
    },
    "scrub": {
      "$ref": "#/$defs/SnapraidScrub"
    },
    "settings": {
      "$ref": "#/$defs/SnapraidSettings"
    },
    "thresholds": {
      "$ref": "#/$defs/SnapraidThresholds"
    }
  },
  "additionalProperties": false,
  "required": [
    "enabled",
    "drives",
    "excludes",
    "settings",
    "thresholds",
    "scrub",
    "schedule"
  ],
  "$defs": {
    "SnapraidDrive": {
      "type": "object",
      "properties": {
        "content": {
          "type": "boolean"
        },
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "parity_level": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "path": {
          "type": "string"
        },
        "role": {
          "$ref": "#/$defs/SnapraidRole"
        },
        "uuid": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "path",
        "uuid",
        "role",
        "content",
        "parity_level"
      ]
    },
    "SnapraidRole": {
      "type": "string",
      "enum": [
        "data",
        "parity"
      ]
    },
    "SnapraidSchedule": {
      "type": "object",
      "properties": {
        "scrub_cron": {
          "type": "string"
        },
        "scrub_enabled": {
          "type": "boolean"
        },
        "sync_cron": {
          "type": "string"
        },
        "sync_enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "sync_enabled",
        "sync_cron",
        "scrub_enabled",
        "scrub_cron"
      ]
    },
    "SnapraidScrub": {
      "type": "object",
      "properties": {
        "age_days": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "enabled": {
          "type": "boolean"
        },
        "percent": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "percent",
        "age_days"
      ]
    },
    "SnapraidSettings": {
      "type": "object",
      "properties": {
        "autosave": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "blocksize": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "hashsize": {
          "type": "integer",
          "format": "uint8",
          "maximum": 255,
          "minimum": 0
        },
        "nohidden": {
          "type": "boolean"
        },
        "prehash": {
          "type": "boolean"
        }
      },
      "additionalProperties": false,
      "required": [
        "blocksize",
        "hashsize",
        "autosave",
        "nohidden",
        "prehash"
      ]
    },
    "SnapraidThresholds": {
      "type": "object",
      "properties": {
        "delete_threshold": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "update_threshold": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "delete_threshold",
        "update_threshold"
      ]
    }
  }
}
