{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PlannedCompose",
  "type": "object",
  "properties": {
    "digest": {
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/ComposePlan"
    }
  },
  "additionalProperties": false,
  "required": [
    "plan",
    "digest"
  ],
  "$defs": {
    "ComposeDevice": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string"
        },
        "target": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "source",
        "target"
      ]
    },
    "ComposeFile": {
      "type": "object",
      "properties": {
        "name": {
          "$ref": "#/$defs/ComposeFileName"
        },
        "sha256": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "sha256"
      ]
    },
    "ComposeFileName": {
      "type": "string",
      "enum": [
        "compose.yaml",
        "compose.yml",
        "docker-compose.yaml",
        "docker-compose.yml"
      ]
    },
    "ComposeImpact": {
      "type": "object",
      "properties": {
        "elevated": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposePrivilege"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeServiceChange"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "services",
        "elevated"
      ]
    },
    "ComposeMount": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "volume"
            },
            "name": {
              "type": "string"
            },
            "read_only": {
              "type": "boolean"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "name",
            "target",
            "read_only"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bind"
            },
            "read_only": {
              "type": "boolean"
            },
            "source": {
              "type": "string"
            },
            "target": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "source",
            "target",
            "read_only"
          ]
        }
      ]
    },
    "ComposePlan": {
      "type": "object",
      "properties": {
        "before": {
          "$ref": "#/$defs/ComposeProject"
        },
        "catalog_digest": {
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "desired": {
          "$ref": "#/$defs/ComposeProject"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "impact": {
          "$ref": "#/$defs/ComposeImpact"
        },
        "managed_file": {
          "type": "string"
        },
        "operator_files": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeFile"
          }
        },
        "principal": {
          "type": "string"
        },
        "selection": {
          "$ref": "#/$defs/ComposeSelection"
        },
        "template_digest": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "catalog_digest",
        "template_digest",
        "selection",
        "operator_files",
        "managed_file",
        "before",
        "desired",
        "impact",
        "created_at",
        "expires_at"
      ]
    },
    "ComposePort": {
      "type": "object",
      "properties": {
        "host_ip": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/PortProtocol"
        },
        "published": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "target": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "host_ip",
        "published",
        "target",
        "protocol"
      ]
    },
    "ComposePrivilege": {
      "type": "string",
      "enum": [
        "privileged",
        "host_mount",
        "device",
        "docker_socket",
        "host_network"
      ]
    },
    "ComposeProject": {
      "type": "object",
      "properties": {
        "services": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeService"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "services"
      ]
    },
    "ComposeRestart": {
      "type": "string",
      "enum": [
        "no",
        "always",
        "on-failure",
        "unless-stopped"
      ]
    },
    "ComposeSelection": {
      "type": "object",
      "properties": {
        "stack": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stack",
        "template"
      ]
    },
    "ComposeService": {
      "type": "object",
      "properties": {
        "devices": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeDevice"
          }
        },
        "host_network": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "mounts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposeMount"
          }
        },
        "name": {
          "type": "string"
        },
        "ports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ComposePort"
          }
        },
        "privileged": {
          "type": "boolean"
        },
        "restart": {
          "$ref": "#/$defs/ComposeRestart"
        },
        "user": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeUser"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "image",
        "restart",
        "ports",
        "mounts",
        "devices",
        "privileged",
        "host_network"
      ]
    },
    "ComposeServiceChange": {
      "type": "object",
      "properties": {
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeService"
            },
            {
              "type": "null"
            }
          ]
        },
        "before": {
          "anyOf": [
            {
              "$ref": "#/$defs/ComposeService"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "ComposeUser": {
      "type": "object",
      "properties": {
        "gid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "uid",
        "gid"
      ]
    },
    "PortProtocol": {
      "type": "string",
      "enum": [
        "tcp",
        "udp"
      ]
    }
  }
}
