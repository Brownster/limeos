{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "nonce": {
          "type": "string",
          "maxLength": 64,
          "minLength": 64
        },
        "operation": {
          "type": "string",
          "const": "container_health"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "nonce"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "stack_inventory"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "storage_mount_catalog"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
