            "$ref": "#/$defs/TargetEvidence"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "version",
        "operation",
        "action",
        "expected",
        "contract",
        "targets",
        "created_at",
        "expires_at"
      ]
