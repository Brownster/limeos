        "version",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "storage_mount_receipt"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest"
      ]
    },
    {
      "description": "Refine only an existing accepted, reaped effect after fresh verification.\nThis request cannot launch an effect or renew execution authority.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "reconcile_storage_mount"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "inspect_mounted_storage"
        },
        "plan": {
          "$ref": "#/$defs/StorageMountEffectPlan"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "container_storage_inventory"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "contract": {
          "$ref": "#/$defs/StorageContract"
        },
        "operation": {
          "type": "string",
          "const": "inspect_storage_targets"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "contract"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "prepare_storage_targets"
        },
        "plan": {
          "$ref": "#/$defs/TargetPreparationPlan"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "storage_target_receipt"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "storage_inventory"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "health"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version"
      ]
    },
    {
      "description": "The container executor's current receipt-store epoch (`Receipt::epoch`),\nanswered without reading or locking the store. Core asks for it\nimmediately before it claims a job for dispatch, and dispatches the\njob under it.",
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "receipt_epoch"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "operation": {
          "type": "string",
          "const": "observe"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "source",
        "active"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "inspect"
        },
        "resource": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "container_logs"
        },
        "options": {
          "$ref": "#/$defs/LogOptions"
        },
        "resource": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "resource",
        "options"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "restart"
        },
        "request": {
          "$ref": "#/$defs/ContainerRequest"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "request"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "execute_container"
        },
        "request": {
          "$ref": "#/$defs/ContainerRequest"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "request"
      ]
    },
    {
      "description": "Receipt lookup. With no receipt, the answer's `absence` says whether\none can ever have been pruned for `plan`. The executor recomputes the\nplan's digest and refuses the request unless it equals `digest`, so the\nexpiry it judges by is the approved plan's own.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "close_if_absent": {
          "description": "With no row, record a closure: a terminal refusal that takes the\naction ID, so no execute request for it can run afterwards,\nwhatever the clock says. Only for a caller that has lost the answer\nto its execute request; a status read leaves it false and writes\nnothing. A `never_recorded` closure is answered with its receipt\n(`precondition_changed`), a `no_longer_held` one with that absence;\neither way the answer's `closed` is set.",
          "type": "boolean",
          "default": false
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "restart_receipt"
        },
        "plan": {
          "description": "The plan exactly as core stored it.",
          "$ref": "#/$defs/ContainerPlan"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest",
        "plan"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "after": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "verify_restart"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest",
        "after"
      ]
    },
    {
      "description": "Fresh Engine listing of one Compose project's ordinary members.",
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "inspect_stack"
        },
        "project": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "project"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "execute_stack"
        },
        "request": {
          "$ref": "#/$defs/StackRequest"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "request"
      ]
    },
    {
      "description": "As `RestartReceipt`, for a whole-stack action.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "close_if_absent": {
          "description": "As for `RestartReceipt`.",
          "type": "boolean",
          "default": false
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "stack_receipt"
        },
        "plan": {
          "$ref": "#/$defs/StackPlan"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest",
        "plan"
      ]
    },
    {
      "description": "Fresh inspections of the plan's targets; never launches an effect.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "after": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerSnapshot"
          }
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "verify_stack"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest",
        "after"
      ]
    },
    {
      "description": "Operator resolution of a stuck action. The executor re-inspects the\naction's targets read-only and, only if the result still hashes to\n`evidence_digest`, moves its own rows to `resolved` so the resource\nfrees. Idempotent by action. Never issues an Engine start, stop or\nrestart. With no row it always records a closure, as a receipt lookup\nwith `close_if_absent` does, and answers the absence with `closed`.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "declared": {
          "$ref": "#/$defs/DeclaredOutcome"
        },
        "digest": {
          "description": "Digest of the stored plan, as for the receipt lookups.",
          "type": "string"
        },
        "disputed": {
          "description": "Core holds a record a `never_recorded` closure for the action\nwould contradict: the receipt store changed while core held the\njob (`executor_store_changed`), or core recorded a result for it.\nSuch a closure is then not evidence, and every declaration is left\nto the operator's fresh measurement; without it a `never_recorded`\nclosure allows only what a `precondition_changed` receipt allows.",
          "type": "boolean",
          "default": false
        },
        "evidence_digest": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ResolveKind"
        },
        "operation": {
          "type": "string",
          "const": "resolve_action"
        },
        "plan": {
          "description": "The plan exactly as core stored it: of `kind`, and hashing to\n`digest`, or the request is invalid. With no row, its own\n`expires_at` decides the answer's `absence`.",
          "$ref": "#/$defs/ActionPlan"
        },
        "resolved_by": {
          "description": "The resolving administrator's principal ID, recorded in the row.",
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "kind",
        "action",
        "digest",
        "evidence_digest",
        "declared",
        "resolved_by",
        "plan"
      ]
    }
  ],
  "$defs": {
    "ActionPlan": {
      "description": "The plan an action was approved with, exactly as core stored it. A receipt\nlookup or `ResolveAction` carries it so the executor can recompute its\ndigest, require it to equal the digest the request names, and judge a\nmissing receipt by the plan's own `expires_at`, never by a bare number.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "container": {
              "$ref": "#/$defs/ContainerPlan"
            }
          },
          "additionalProperties": false,
          "required": [
            "container"
          ]
        },
        {
          "type": "object",
          "properties": {
            "stack": {
              "$ref": "#/$defs/StackPlan"
            }
          },
          "additionalProperties": false,
          "required": [
            "stack"
          ]
        }
      ]
    },
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "ContainerRequest": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        },
        "plan_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "plan_digest",
        "plan"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "DeclaredOutcome": {
      "description": "What the administrator declares about the job. Only `AcceptedDivergence`\nrests on the operator's word; the other two are checked against evidence.",
      "oneOf": [
        {
          "description": "The intended end state is present on every target.",
          "type": "string",
          "const": "verified_done"
        },
        {
          "description": "Nothing took effect: every target still equals the plan's `expected`.",
          "type": "string",
          "const": "not_done"
        },
        {
          "description": "The present state differs from both before and intended; accepted.",
          "type": "string",
          "const": "accepted_divergence"
        }
      ]
    },
    "DirectoryIdentity": {
      "type": "object",
      "properties": {
        "gid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "inode": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "major": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "mode": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "mount_id": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "uid": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor",
        "mount_id",
        "inode",
        "mode",
        "uid",
        "gid"
      ]
    },
    "LogOptions": {
      "type": "object",
      "properties": {
        "tail": {
          "type": "integer",
          "format": "uint16",
          "default": 100,
          "maximum": 200,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "ResolveKind": {
      "description": "Which executor table holds the action: one container or a whole stack.",
      "type": "string",
      "enum": [
        "container",
        "stack"
      ]
    },
    "Source": {
      "type": "string",
      "enum": [
        "host",
        "storage",
        "pools",
        "docker",
        "history"
      ]
    },
    "StackPlan": {
      "type": "object",
      "properties": {
        "catalog_stack": {
          "description": "The registered catalog stack name; may differ from the Compose project.",
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/StackSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "operation",
        "principal",
        "grant_revision",
        "catalog_stack",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "StackRequest": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/StackPlan"
        },
        "plan_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "plan_digest",
        "plan"
      ]
    },
    "StackSnapshot": {
      "description": "Every ordinary (non one-off) member, stopped or running, sorted by ID.",
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerSnapshot"
          }
        },
        "resource": {
          "type": "string"
        }
