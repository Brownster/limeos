      "required": [
        "version",
        "operation",
        "action",
        "device",
        "expected",
        "target",
        "physical_devices",
        "consumer_digest",
        "created_at",
        "expires_at"
      ]
    },
    "StorageMountSelection": {
      "type": "object",
      "properties": {
