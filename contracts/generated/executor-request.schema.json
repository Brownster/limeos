{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "health"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "operation": {
          "type": "string",
          "const": "observe"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "source",
        "active"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "inspect"
        },
        "resource": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "restart"
        },
        "request": {
          "$ref": "#/$defs/RestartRequest"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "request"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "restart_receipt"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest"
      ]
    },
    {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "after": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "digest": {
          "type": "string"
        },
        "operation": {
          "type": "string",
          "const": "verify_restart"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "action",
        "digest",
        "after"
      ]
    }
  ],
  "$defs": {
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "RestartPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "RestartRequest": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/RestartPlan"
        },
        "plan_digest": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "plan_digest",
        "plan"
      ]
    },
    "Source": {
      "type": "string",
      "enum": [
        "host",
        "storage",
        "pools",
        "docker",
        "history"
      ]
    }
  }
}
