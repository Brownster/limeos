{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Request",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "operation": {
          "type": "string",
          "const": "health"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "active": {
          "type": "boolean"
        },
        "operation": {
          "type": "string",
          "const": "observe"
        },
        "source": {
          "$ref": "#/$defs/Source"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "operation",
        "version",
        "source",
        "active"
      ]
    }
  ],
  "$defs": {
    "Source": {
      "type": "string",
      "enum": [
        "host",
        "storage",
        "pools",
        "docker",
        "history"
      ]
    }
  }
}
