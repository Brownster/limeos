            "string",
            "null"
          ],
          "maxLength": 128,
          "minLength": 1
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "filesystem_uuid",
        "filesystem",
        "mountpoint"
      ]
    },
    "StorageFilesystem": {
      "type": "string",
      "enum": [
        "btrfs",
        "exfat",
        "ext2",
        "ext3",
        "ext4",
        "ntfs",
        "vfat",
        "xfs"
      ]
    },
    "StorageFstabEntry": {
      "description": "Only identity/target fields leave the protected reader. Fstab options may\ncontain credentials and are never copied into RPC, plans or HTTP responses.",
      "type": "object",
      "properties": {
        "device": {
          "anyOf": [
            {
              "$ref": "#/$defs/StorageBlockDevice"
            },
            {
              "type": "null"
            }
          ]
