{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreRequest",
  "description": "No principal name or role is accepted from a local caller. Privileged local\nenrollment is gated by kernel credentials in the composition root.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "health"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "issue_bootstrap"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "enrollment": {
          "$ref": "#/$defs/Enrollment"
        },
        "request": {
          "type": "string",
          "const": "enroll"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "enrollment"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "request": {
          "type": "string",
          "const": "check_task"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "operation",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "propose_restart"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/QueueRestartInput"
        },
        "request": {
          "type": "string",
          "const": "queue_restart"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "input"
      ]
    }
  ],
  "$defs": {
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "Enrollment": {
      "type": "object",
      "properties": {
        "password": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token",
        "username",
        "password"
      ]
    },
    "Operation": {
      "type": "string",
      "enum": [
        "health_read",
        "media_request",
        "container_manage",
        "storage_manage",
        "identity_manage"
      ]
    },
    "PlannedRestart": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/RestartPlan"
        }
      },
      "additionalProperties": false,
      "required": [
        "plan",
        "digest"
      ]
    },
    "QueueRestartInput": {
      "type": "object",
      "properties": {
        "approval": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/PlannedRestart"
        }
      },
      "additionalProperties": false,
      "required": [
        "proposal",
        "approval",
        "idempotency_key"
      ]
    },
    "RestartPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    }
  }
}
