{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreRequest",
  "description": "No principal name or role is accepted from a local caller. Privileged local\nenrollment is gated by kernel credentials in the composition root.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "health"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "issue_bootstrap"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "enrollment": {
          "$ref": "#/$defs/Enrollment"
        },
        "request": {
          "type": "string",
          "const": "enroll"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "enrollment"
      ]
    },
    {
      "description": "Root-peer only, like `Enroll`. All-or-nothing and idempotent.",
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "import_legacy_users"
        },
        "users": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/LegacyUser"
          }
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "users"
      ]
    },
    {
      "description": "Root-peer only. Read-only evidence for a stuck job, as the named\nadministrator would see it over HTTP. `admin` is a username; core\nrefuses anyone who is not currently an administrator.",
      "type": "object",
      "properties": {
        "admin": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "request": {
          "type": "string",
          "const": "read_resolution"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "admin",
        "job"
      ]
    },
    {
      "description": "Root-peer only. The root peer is the re-authentication, so no password\nis sent. Core stores `admin` as the resolving principal and marks the\nreason as entered through `limeosctl`.",
      "type": "object",
      "properties": {
        "admin": {
          "type": "string"
        },
        "declared": {
          "$ref": "#/$defs/DeclaredOutcome"
        },
        "evidence_digest": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "request": {
          "type": "string",
          "const": "resolve_job"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "admin",
        "job",
        "declared",
        "reason",
        "evidence_digest"
      ]
    },
    {
      "description": "Root-peer only. Every principal's jobs that `filter` matches, oldest\nfirst, at most `limit` (1 to `limeos_domain::MAX_OPERATOR_JOBS`) from\n`filter.after` on. Read-only.",
      "type": "object",
      "properties": {
        "filter": {
          "$ref": "#/$defs/OperatorJobFilter"
        },
        "limit": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "request": {
          "type": "string",
          "const": "list_jobs"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "filter",
        "limit"
      ]
    },
    {
      "description": "Root-peer only. Cancel one queued job on its owner's behalf. As for\n`ResolveJob`, `admin` names a current administrator, recorded as the\nactor; the root peer is the re-authentication.",
      "type": "object",
      "properties": {
        "admin": {
          "type": "string"
        },
        "job": {
          "type": "string"
        },
        "request": {
          "type": "string",
          "const": "cancel_job"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "admin",
        "job"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "request": {
          "type": "string",
          "const": "check_task"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "operation",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "propose_restart"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/QueueRestartInput"
        },
        "request": {
          "type": "string",
          "const": "queue_restart"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "request": {
          "type": "string",
          "const": "propose_container"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "resource",
        "operation"
      ]
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/QueueRestartInput"
        },
        "request": {
          "type": "string",
          "const": "queue_container"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "options": {
          "$ref": "#/$defs/LogOptions"
        },
        "request": {
          "type": "string",
          "const": "read_container_logs"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "resource",
        "options"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "propose_compose"
        },
        "selection": {
          "$ref": "#/$defs/ComposeSelection"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "selection"
      ]
    }
  ],
  "$defs": {
    "ComposeSelection": {
      "type": "object",
      "properties": {
        "stack": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stack",
        "template"
      ]
    },
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "DeclaredOutcome": {
      "description": "What the administrator declares about the job. Only `AcceptedDivergence`\nrests on the operator's word; the other two are checked against evidence.",
      "oneOf": [
        {
          "description": "The intended end state is present on every target.",
          "type": "string",
          "const": "verified_done"
        },
        {
          "description": "Nothing took effect: every target still equals the plan's `expected`.",
          "type": "string",
          "const": "not_done"
        },
        {
          "description": "The present state differs from both before and intended; accepted.",
          "type": "string",
          "const": "accepted_divergence"
        }
      ]
    },
    "Enrollment": {
      "type": "object",
      "properties": {
        "password": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token",
        "username",
        "password"
      ]
    },
    "JobFamily": {
      "description": "The job families core can queue, one per group of intent operations.",
      "oneOf": [
        {
          "description": "`container_restart`, `container_start`, `container_stop`.",
          "type": "string",
          "const": "container"
        },
        {
          "description": "`stack_restart`, `stack_start`, `stack_stop`.",
          "type": "string",
          "const": "stack"
        },
        {
          "description": "`storage_prepare_targets`.",
          "type": "string",
          "const": "storage_targets"
        },
        {
          "description": "`storage_mount`.",
          "type": "string",
          "const": "storage_mount"
        },
        {
          "description": "`automation_observe_health`.",
          "type": "string",
          "const": "automation_observation"
        },
        {
          "description": "`health_probe`.",
          "type": "string",
          "const": "health_probe"
        },
        {
          "description": "`backup_prepare_private`.",
          "type": "string",
          "const": "backup_preparation"
        }
      ]
    },
    "JobState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "planned",
            "waiting_approval",
            "queued",
            "running",
            "verifying",
            "succeeded",
            "failed",
            "canceled",
            "precondition_changed",
            "outcome_unknown",
            "needs_intervention"
          ]
        },
        {
          "description": "An administrator settled an uncertain job on evidence. Terminal and\nlock-releasing; the original job, plan and receipts stay unchanged.",
          "type": "string",
          "const": "resolved"
        }
      ]
    },
    "LegacyUser": {
      "description": "One legacy user as read from the frozen app's env file. The hash is secret\nmaterial: no `Debug`, and it never appears in errors or logs.",
      "type": "object",
      "properties": {
        "password_hash": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "username",
        "password_hash"
      ]
    },
    "LogOptions": {
      "type": "object",
      "properties": {
        "tail": {
          "type": "integer",
          "format": "uint16",
          "default": 100,
          "maximum": 200,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "Operation": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "health_read",
            "media_request",
            "container_manage",
            "deployment_manage",
            "deployment_elevated",
            "storage_manage",
            "identity_manage",
            "automation_manage"
          ]
        },
        {
          "description": "Administrator-only settlement of a `needs_intervention` job. Never\ngrantable to a task token, API key or wildcard scope.",
          "type": "string",
          "const": "job_resolve"
        }
      ]
    },
    "OperatorJobFilter": {
      "description": "Which jobs a listing shows. Every field narrows it.",
      "type": "object",
      "properties": {
        "after": {
          "description": "Continue after this listing position: an earlier page's `next`.",
          "type": [
            "integer",
            "null"
          ],
          "format": "int64"
        },
        "family": {
          "anyOf": [
            {
              "$ref": "#/$defs/JobFamily"
            },
            {
              "type": "null"
            }
          ]
        },
        "job": {
          "description": "Exactly this job.",
          "type": [
            "string",
            "null"
          ]
        },
        "owner": {
          "description": "The owner's username.",
          "type": [
            "string",
            "null"
          ]
        },
        "states": {
          "description": "1 to 12 states.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/JobState"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "states"
      ]
    },
    "PlannedContainerAction": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        }
      },
      "additionalProperties": false,
      "required": [
        "plan",
        "digest"
      ]
    },
    "QueueRestartInput": {
      "type": "object",
      "properties": {
        "approval": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/PlannedContainerAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "proposal",
        "approval",
        "idempotency_key"
      ]
    }
  }
}
