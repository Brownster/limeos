{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CoreRequest",
  "description": "No principal name or role is accepted from a local caller. Privileged local\nenrollment is gated by kernel credentials in the composition root.",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "health"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "issue_bootstrap"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version"
      ]
    },
    {
      "type": "object",
      "properties": {
        "enrollment": {
          "$ref": "#/$defs/Enrollment"
        },
        "request": {
          "type": "string",
          "const": "enroll"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "enrollment"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/Operation"
        },
        "request": {
          "type": "string",
          "const": "check_task"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "operation",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "propose_restart"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "resource"
      ]
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/QueueRestartInput"
        },
        "request": {
          "type": "string",
          "const": "queue_restart"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "request": {
          "type": "string",
          "const": "propose_container"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "resource",
        "operation"
      ]
    },
    {
      "type": "object",
      "properties": {
        "input": {
          "$ref": "#/$defs/QueueRestartInput"
        },
        "request": {
          "type": "string",
          "const": "queue_container"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "input"
      ]
    },
    {
      "type": "object",
      "properties": {
        "options": {
          "$ref": "#/$defs/LogOptions"
        },
        "request": {
          "type": "string",
          "const": "read_container_logs"
        },
        "resource": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "resource",
        "options"
      ]
    },
    {
      "type": "object",
      "properties": {
        "request": {
          "type": "string",
          "const": "propose_compose"
        },
        "selection": {
          "$ref": "#/$defs/ComposeSelection"
        },
        "task": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "request",
        "version",
        "token",
        "task",
        "selection"
      ]
    }
  ],
  "$defs": {
    "ComposeSelection": {
      "type": "object",
      "properties": {
        "stack": {
          "type": "string"
        },
        "template": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "stack",
        "template"
      ]
    },
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "Enrollment": {
      "type": "object",
      "properties": {
        "password": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "username": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "token",
        "username",
        "password"
      ]
    },
    "LogOptions": {
      "type": "object",
      "properties": {
        "tail": {
          "type": "integer",
          "format": "uint16",
          "default": 100,
          "maximum": 200,
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "Operation": {
      "type": "string",
      "enum": [
        "health_read",
        "media_request",
        "container_manage",
        "deployment_manage",
        "deployment_elevated",
        "storage_manage",
        "identity_manage"
      ]
    },
    "PlannedContainerAction": {
      "type": "object",
      "properties": {
        "digest": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/ContainerPlan"
        }
      },
      "additionalProperties": false,
      "required": [
        "plan",
        "digest"
      ]
    },
    "QueueRestartInput": {
      "type": "object",
      "properties": {
        "approval": {
          "type": "string"
        },
        "idempotency_key": {
          "type": "string"
        },
        "proposal": {
          "$ref": "#/$defs/PlannedContainerAction"
        }
      },
      "additionalProperties": false,
      "required": [
        "proposal",
        "approval",
        "idempotency_key"
      ]
    }
  }
}
