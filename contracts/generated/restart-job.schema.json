{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RestartJob",
  "type": "object",
  "properties": {
    "id": {
      "type": "string"
    },
    "plan": {
      "$ref": "#/$defs/RestartPlan"
    },
    "state": {
      "$ref": "#/$defs/JobState"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "state",
    "plan"
  ],
  "$defs": {
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "JobState": {
      "type": "string",
      "enum": [
        "planned",
        "waiting_approval",
        "queued",
        "running",
        "verifying",
        "succeeded",
        "failed",
        "canceled",
        "precondition_changed",
        "outcome_unknown",
        "needs_intervention"
      ]
    },
    "RestartPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/ContainerSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    }
  }
}
