{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StackJobProgress",
  "description": "Owner-scoped progress. `receipt` carries the per-member outcomes recorded\nby the executor once any exist; `verification` is core's own fresh evidence.",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "job": {
      "$ref": "#/$defs/StackJob"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/StackReceipt"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "job",
    "events"
  ],
  "$defs": {
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "ErrorCode": {
      "type": "string",
      "enum": [
        "invalid_input",
        "unauthenticated",
        "forbidden",
        "conflict",
        "expired",
        "overloaded",
        "unavailable",
        "storage_mount_limit",
        "corrupt_configuration",
        "state_not_durable",
        "not_found"
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "created": {
          "type": "integer",
          "format": "int64"
        },
        "cursor": {
          "type": "integer",
          "format": "int64"
        },
        "event": {
          "$ref": "#/$defs/EventKind"
        },
        "job": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "cursor",
        "event",
        "created"
      ]
    },
    "EventKind": {
      "description": "Authority events contain stable types and identifiers, never credentials.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bootstrap_issued"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "administrator_enrolled"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "legacy_identity_imported"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session_created"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session_revoked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "grants_revised"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task_issued"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task_revoked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_queued"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_recovery_required"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_transition"
            },
            "state": {
              "$ref": "#/$defs/JobState"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan_created"
            },
            "plan": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan_approved"
            },
            "plan": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan_canceled"
            },
            "plan": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_schedule_created"
            },
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schedule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_schedule_changed"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            },
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schedule",
            "revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "due": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "const": "automation_occurrence_settled"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            },
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schedule",
            "revision",
            "due"
          ]
        },
        {
          "type": "object",
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "automation_observation_settled"
            },
            "sequence": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sequence",
            "complete"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "automation_observation_polled"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_published"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "automation_notification_created"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_pruned"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_acknowledged"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "automation_health_policy_changed"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "revision",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_policy_checked"
            },
            "notification": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification",
            "revision"
          ]
        }
      ]
    },
    "ExecutionState": {
      "type": "string",
      "enum": [
        "prepared",
        "effect_accepted",
        "verified",
        "precondition_changed",
        "outcome_unknown"
      ]
    },
    "JobState": {
      "type": "string",
      "enum": [
        "planned",
        "waiting_approval",
        "queued",
        "running",
        "verifying",
        "succeeded",
        "failed",
        "canceled",
        "precondition_changed",
        "outcome_unknown",
        "needs_intervention"
      ]
    },
    "StackJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/StackPlan"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "plan"
      ]
    },
    "StackMemberReceipt": {
      "type": "object",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExecutionState"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "state"
      ]
    },
    "StackPlan": {
      "type": "object",
      "properties": {
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/StackSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "operation",
        "principal",
        "grant_revision",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "StackReceipt": {
      "description": "`state` is always the aggregate of `members`, which lists exactly the\nplan's targets. A member that was never sent is `precondition_changed`.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/StackSnapshot"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StackMemberReceipt"
          }
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "plan_digest": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExecutionState"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "plan_digest",
        "operation",
        "before",
        "state",
        "members"
      ]
    },
    "StackSnapshot": {
      "description": "Every ordinary (non one-off) member, stopped or running, sorted by ID.",
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerSnapshot"
          }
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "members"
      ]
    }
  }
}
