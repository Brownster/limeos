{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StackJobProgress",
  "description": "Owner-scoped progress. `receipt` carries the per-member outcomes recorded\nby the executor once any exist; it is absent before the job runs.",
  "type": "object",
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/Event"
      }
    },
    "job": {
      "$ref": "#/$defs/StackJob"
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "#/$defs/StackReceipt"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "job",
    "events"
  ],
  "$defs": {
    "ContainerAction": {
      "type": "string",
      "enum": [
        "restart",
        "start",
        "stop"
      ]
    },
    "ContainerSnapshot": {
      "description": "Selected inspection evidence. Environment variables, labels and host paths\nnever enter a plan. The full ID, image and start timestamp identify an instance.",
      "type": "object",
      "properties": {
        "image": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "running": {
          "type": "boolean"
        },
        "started_at": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "image",
        "started_at",
        "running"
      ]
    },
    "DeclaredOutcome": {
      "description": "What the administrator declares about the job. Only `AcceptedDivergence`\nrests on the operator's word; the other two are checked against evidence.",
      "oneOf": [
        {
          "description": "The intended end state is present on every target.",
          "type": "string",
          "const": "verified_done"
        },
        {
          "description": "Nothing took effect: every target still equals the plan's `expected`.",
          "type": "string",
          "const": "not_done"
        },
        {
          "description": "The present state differs from both before and intended; accepted.",
          "type": "string",
          "const": "accepted_divergence"
        }
      ]
    },
    "ErrorCode": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "invalid_input",
            "unauthenticated",
            "forbidden",
            "conflict",
            "expired",
            "overloaded",
            "unavailable",
            "storage_mount_limit",
            "corrupt_configuration",
            "state_not_durable",
            "not_found"
          ]
        },
        {
          "description": "The container executor refused an execute request for an action it\nholds no receipt for, because the plan expires at or below its prune\nwatermark: a receipt for it may have been pruned, so the executor can\nno longer tell whether the action already ran. Never retried as an\neffect. Fresh plans meet it only after the clock stepped back by more\nthan the receipt retention period, until the clock catches up.",
          "type": "string",
          "const": "beyond_receipt_history"
        }
      ]
    },
    "Event": {
      "type": "object",
      "properties": {
        "created": {
          "type": "integer",
          "format": "int64"
        },
        "cursor": {
          "type": "integer",
          "format": "int64"
        },
        "event": {
          "$ref": "#/$defs/EventKind"
        },
        "job": {
          "type": [
            "string",
            "null"
          ]
        },
        "principal": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "cursor",
        "event",
        "created"
      ]
    },
    "EventKind": {
      "description": "Authority events contain stable types and identifiers, never credentials.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "bootstrap_issued"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "administrator_enrolled"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "legacy_identity_imported"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session_created"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "session_revoked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "grants_revised"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task_issued"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "task_revoked"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_queued"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_recovery_required"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "The executor answered that it holds no receipt for this job, after its\nreceipt may have been pruned: whether the action ran is unknown, and the\njob stays held for an operator.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "executor_receipt_missing"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "The container executor's receipt store changed while this job was held:\nan answer carried a store epoch other than the one core last saw (a\nstore reopened, lost and recreated, or restored from an older copy).\nThe store may have lost what this job did, so a `never_recorded`\nclosure for it is not accepted.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "executor_store_changed"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "The executor answered with a closure saying it never recorded this job,\nwhich contradicts what core holds: a result core already recorded, or\na dispatch under an earlier store epoch. Nothing was released; the job\nstays held for an operator.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "executor_record_disagrees"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_transition"
            },
            "state": {
              "$ref": "#/$defs/JobState"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "declared": {
              "$ref": "#/$defs/DeclaredOutcome"
            },
            "kind": {
              "type": "string",
              "const": "job_resolution_requested"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "declared"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_resolution_withdrawn"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind"
          ]
        },
        {
          "description": "An open resolution request was closed without effect: the job had\nalready settled by another path (recovery recorded the executor's\nreceipt or closure) as `state`, so the request could never complete.",
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "job_resolution_superseded"
            },
            "state": {
              "$ref": "#/$defs/JobState"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "declared": {
              "$ref": "#/$defs/DeclaredOutcome"
            },
            "kind": {
              "type": "string",
              "const": "job_resolved"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "declared"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan_created"
            },
            "plan": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan_approved"
            },
            "plan": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "plan_canceled"
            },
            "plan": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "plan"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_schedule_created"
            },
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schedule"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_schedule_changed"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            },
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schedule",
            "revision"
          ]
        },
        {
          "type": "object",
          "properties": {
            "due": {
              "type": "integer",
              "format": "int64"
            },
            "kind": {
              "type": "string",
              "const": "automation_occurrence_settled"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            },
            "schedule": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "schedule",
            "revision",
            "due"
          ]
        },
        {
          "type": "object",
          "properties": {
            "complete": {
              "type": "boolean"
            },
            "kind": {
              "type": "string",
              "const": "automation_observation_settled"
            },
            "sequence": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "sequence",
            "complete"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "automation_observation_polled"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_published"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "automation_notification_created"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_pruned"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_acknowledged"
            },
            "notification": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification"
          ]
        },
        {
          "type": "object",
          "properties": {
            "digest": {
              "type": "string"
            },
            "kind": {
              "type": "string",
              "const": "automation_health_policy_changed"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "revision",
            "digest"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "automation_notification_policy_checked"
            },
            "notification": {
              "type": "string"
            },
            "revision": {
              "type": "integer",
              "format": "int64"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "notification",
            "revision"
          ]
        }
      ]
    },
    "ExecutionState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "prepared",
            "effect_accepted",
            "verified",
            "precondition_changed",
            "outcome_unknown"
          ]
        },
        {
          "description": "Stack aggregate only: every sent member is verified and every other\nmember is provably unsent. Terminal; never reported as success.",
          "type": "string",
          "const": "partly_done"
        }
      ]
    },
    "JobState": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "planned",
            "waiting_approval",
            "queued",
            "running",
            "verifying",
            "succeeded",
            "failed",
            "canceled",
            "precondition_changed",
            "outcome_unknown",
            "needs_intervention"
          ]
        },
        {
          "description": "An administrator settled an uncertain job on evidence. Terminal and\nlock-releasing; the original job, plan and receipts stay unchanged.",
          "type": "string",
          "const": "resolved"
        }
      ]
    },
    "StackJob": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "plan": {
          "$ref": "#/$defs/StackPlan"
        },
        "state": {
          "$ref": "#/$defs/JobState"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "plan"
      ]
    },
    "StackMemberReceipt": {
      "type": "object",
      "properties": {
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "resource": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExecutionState"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "state"
      ]
    },
    "StackPlan": {
      "type": "object",
      "properties": {
        "catalog_stack": {
          "description": "The registered catalog stack name; may differ from the Compose project.",
          "type": "string"
        },
        "created_at": {
          "type": "integer",
          "format": "int64"
        },
        "expected": {
          "$ref": "#/$defs/StackSnapshot"
        },
        "expires_at": {
          "type": "integer",
          "format": "int64"
        },
        "grant_revision": {
          "type": "integer",
          "format": "int64"
        },
        "id": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "principal": {
          "type": "string"
        },
        "version": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "operation",
        "principal",
        "grant_revision",
        "catalog_stack",
        "expected",
        "created_at",
        "expires_at"
      ]
    },
    "StackReceipt": {
      "description": "`state` is always the aggregate of `members`, which lists exactly the\nplan's targets. A member that was never sent is `precondition_changed`.",
      "type": "object",
      "properties": {
        "action": {
          "type": "string"
        },
        "before": {
          "$ref": "#/$defs/StackSnapshot"
        },
        "error": {
          "anyOf": [
            {
              "$ref": "#/$defs/ErrorCode"
            },
            {
              "type": "null"
            }
          ]
        },
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/StackMemberReceipt"
          }
        },
        "operation": {
          "$ref": "#/$defs/ContainerAction"
        },
        "plan_digest": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/ExecutionState"
        }
      },
      "additionalProperties": false,
      "required": [
        "action",
        "plan_digest",
        "operation",
        "before",
        "state",
        "members"
      ]
    },
    "StackSnapshot": {
      "description": "Every ordinary (non one-off) member, stopped or running, sorted by ID.",
      "type": "object",
      "properties": {
        "members": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContainerSnapshot"
          }
        },
        "resource": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "resource",
        "members"
      ]
    }
  }
}
