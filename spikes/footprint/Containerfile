# Debian 12 sysroot keeps the result compatible with wybie's glibc 2.36.
FROM rust:1.88.0-bookworm AS build
RUN apt-get update && apt-get install --no-install-recommends -y gcc-aarch64-linux-gnu \
    && rm -rf /var/lib/apt/lists/*
RUN rustup target add aarch64-unknown-linux-gnu
WORKDIR /build
COPY Cargo.toml Cargo.lock rust-toolchain.toml ./
COPY .cargo .cargo
COPY spikes/footprint/Cargo.toml spikes/footprint/Cargo.toml
COPY spikes/footprint/src spikes/footprint/src
RUN cargo build --locked --release -p limeos-footprint
# Bundled SQLite and ring compile C for the target, so its libc headers are required.
RUN apt-get update && apt-get install --no-install-recommends -y libc6-dev-arm64-cross \
    && rm -rf /var/lib/apt/lists/*
RUN CC_aarch64_unknown_linux_gnu=aarch64-linux-gnu-gcc \
    cargo build --locked --release -p limeos-footprint --target aarch64-unknown-linux-gnu
RUN mkdir /artifacts \
    && cp target/release/limeos-footprint /artifacts/limeos-footprint-x86_64 \
    && cp target/aarch64-unknown-linux-gnu/release/limeos-footprint /artifacts/limeos-footprint-aarch64 \
    && rustc --version > /artifacts/toolchain.txt \
    && sha256sum /artifacts/limeos-footprint-* > /artifacts/SHA256SUMS
