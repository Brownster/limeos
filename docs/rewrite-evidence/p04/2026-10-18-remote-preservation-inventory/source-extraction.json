  "schemas": {
    "rclone": {
      "properties": {
        "access_key_id": {
          "description": "Access key",
          "type": "string"
        },
        "backend": {
          "default": "s3",
          "description": "Rclone backend",
          "enum": [
            "s3",
            "s3-compatible"
          ],
          "type": "string"
        },
        "bucket": {
          "description": "Bucket name",
          "type": "string"
        },
        "enabled": {
          "default": false,
          "type": "boolean"
        },
        "endpoint": {
          "description": "Custom endpoint for S3-compatible",
          "type": "string"
        },
        "id": {
          "description": "Unique identifier (lowercase, no spaces)",
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "mount_point": {
          "description": "Local mount point",
          "type": "string"
        },
        "name": {
          "description": "Display name",
          "type": "string"
        },
        "options": {
          "properties": {
            "allow_other": {
              "default": true,
              "type": "boolean"
            },
            "read_only": {
              "default": false,
              "type": "boolean"
            },
            "vfs_cache_mode": {
              "default": "writes",
              "type": "string"
            }
          },
          "type": "object"
        },
        "provider": {
          "default": "AWS",
          "description": "S3 provider",
          "type": "string"
        },
        "region": {
          "default": "us-east-1",
          "type": "string"
        },
        "secret_access_key": {
          "description": "Secret key",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "backend",
        "bucket",
        "mount_point"
      ],
      "type": "object"
    },
    "sshfs": {
      "properties": {
        "auth_type": {
          "default": "password",
          "description": "Authentication method",
          "enum": [
            "password",
            "key"
          ],
          "type": "string"
        },
        "enabled": {
          "default": true,
          "description": "Auto-mount on boot",
          "type": "boolean"
        },
        "host": {
          "description": "Remote hostname or IP",
          "type": "string"
        },
        "id": {
          "description": "Unique identifier (lowercase, no spaces)",
          "pattern": "^[a-z0-9-]+$",
          "type": "string"
        },
        "mount_point": {
          "description": "Local mount point",
          "type": "string"
        },
        "name": {
          "description": "Display name",
          "type": "string"
        },
        "options": {
          "properties": {
            "allow_other": {
              "default": true,
              "type": "boolean"
            },
            "compression": {
              "default": false,
              "type": "boolean"
            },
            "reconnect": {
              "default": true,
              "type": "boolean"
            },
            "server_alive_count_max": {
              "default": 3,
              "type": "integer"
            },
            "server_alive_interval": {
              "default": 15,
              "type": "integer"
            }
          },
          "type": "object"
        },
        "password": {
          "description": "SSH password (stored securely)",
          "type": "string"
        },
        "port": {
          "default": 22,
          "description": "SSH port",
          "type": "integer"
        },
        "remote_path": {
          "description": "Remote directory path",
          "type": "string"
        },
        "ssh_key_path": {
          "description": "Path to SSH private key",
          "type": "string"
        },
        "username": {
          "description": "SSH username",
          "type": "string"
        }
      },
      "required": [
        "id",
        "name",
        "host",
        "username",
        "remote_path",
        "mount_point"
      ],
      "type": "object"
    }
  },
  "seedbox_default_field_expressions": {
    "enabled": "False",
    "host": "''",
    "mount_point": "self._mount_point_provider()",
    "port": "22",
    "remote_path": "''",
    "username": "''"
  }
}
